import Mathlib.Data.Set.Card
import Mathlib.Data.Set.Finite.Basic
import Mathlib.Data.Set.Finite.Lattice
import Mathlib.Order.Concept
import Mathlib.SetTheory.Cardinal.Finite
import MathlibLattice.VersionSpace.Basic

-- The library's files carry no copyright header.
set_option linter.style.header false

/-!
# Version spaces of samples are concept extents

Hypotheses `Θ` are tested against examples `E` through a consistency relation
`cons : Θ → E → Prop`. The version space of a sample `S : Set E` is the set `lowerPolar cons S`
of the hypotheses consistent with every example of `S`, the intersection of the version spaces of
the single examples of `S`. The version spaces of samples are exactly the extents of the formal
context `(Θ, E, cons)`, so the extent map is an order isomorphism from its concept lattice onto
the version spaces of samples ordered by inclusion, and there are as many version spaces of
samples as formal concepts.

For finite samples this needs a chain condition. The concept lattice has no infinite descending
chain exactly when every sample has a finite subsample with the same version space; then the
version spaces of finite samples are again exactly the extents. Without the chain condition this
fails: for `cons θ e ↔ e ≤ θ` on the natural numbers the empty set is an extent, while every
finite sample has a nonempty version space. The number of version spaces of finite samples is
nevertheless always the number of formal concepts.

The version spaces of a hypothesis lattice (`MathlibLattice.VersionSpace.versionSpace`) are the
case in which the examples are labeled instances: a hypothesis is consistent with the instance
`x` labeled `b` when `x` lies in its extension exactly if `b` is `true`.

Conversely the concepts of a formal context `r : α → β → Prop`, ordered by extent inclusion,
form a hypothesis lattice whose extension map is the extent map. For positive objects `Q` and
negative objects `N` its version space, the set of concepts whose extent contains `Q` and misses
`N`, is order-convex, and when it is nonempty its least element is the concept generated by `Q`.
The least element comes from a general fact: if the extension map has a lower adjoint `gen`, a
nonempty version space of positive examples `P` has least element `gen P`.

## Main definitions

* `MathlibLattice.VersionSpace.Consistent`: the consistency of a hypothesis with a labeled
  instance, for an extension map.
* `MathlibLattice.VersionSpace.extentOrderIso`: the extent map, an order isomorphism from the
  concept lattice of `(Θ, E, cons)` onto the version spaces of samples.

## Main statements

* `lowerPolar_eq_biInter`: the version space of a sample is the intersection of the version
  spaces of its examples.
* `versionSpace_eq_lowerPolar`: the version space of positive and negative examples is the
  version space of the corresponding sample of labeled instances.
* `range_lowerPolar`, `exists_versionSpace_eq_iff_isExtent`: the version spaces of samples are
  the extents of the context.
* `card_range_lowerPolar`: there are as many version spaces of samples as formal concepts.
* `wellFoundedLT_concept_iff_exists_finite_subset`, `exists_finite_subset_lowerPolar_eq`: the
  concept lattice has no infinite descending chain iff every sample has a finite subsample with
  the same version space.
* `lowerPolar_image_setOf_finite`: under this chain condition the version spaces of finite
  samples are the extents; `lowerPolar_image_setOf_finite_counterexample` shows that the chain
  condition is needed.
* `card_lowerPolar_image_setOf_finite`: with no chain condition, there are as many version
  spaces of finite samples as formal concepts.
* `isLeast_versionSpace_of_galoisConnection`, `nonempty_versionSpace_iff_of_galoisConnection`,
  `versionSpace_eq_Ici_inter_of_galoisConnection`: least elements, nonemptiness and the shape of
  version spaces for an extension map with a lower adjoint.
* `versionSpace_extent_ordConnected`, `nonempty_versionSpace_extent_iff`,
  `isLeast_ofObjects_versionSpace`: the concepts consistent with positive and negative objects
  form an order-convex set, nonempty iff the extent of the concept generated by the positive
  objects misses the negative ones, and then that concept is its least element.

## References

* T. M. Mitchell, *Generalization as search*, Artificial Intelligence 18, 1982.
* B. Ganter and R. Wille, *Formal Concept Analysis: Mathematical Foundations*, Springer, 1999.
* B. Ganter and S. O. Kuznetsov, *Hypotheses and version spaces*, ICCS 2003, LNCS 2746.
-/

namespace MathlibLattice.VersionSpace

variable {Θ E H X α β : Type*}

/-! ### Version spaces of samples -/

/-- The version space of a sample is the intersection of the version spaces of its examples: a
hypothesis is consistent with every example of `S` iff it lies in `lowerPolar cons {e}` for
every `e ∈ S` (Mitchell 1982). -/
theorem lowerPolar_eq_biInter (cons : Θ → E → Prop) (S : Set E) :
    lowerPolar cons S = ⋂ e ∈ S, lowerPolar cons {e} := by
  aesop

/-- A hypothesis `h` is consistent with the labeled instance `e = (x, b)` for the extension map
`ext` when `x` lies in the extension of `h` exactly if the label `b` is `true`. -/
def Consistent (ext : H → Set X) (h : H) (e : X × Bool) : Prop :=
  e.1 ∈ ext h ↔ e.2 = true

/-- A hypothesis is consistent with a positively labeled instance iff the instance lies in its
extension. -/
@[simp]
theorem consistent_true {ext : H → Set X} {h : H} {x : X} :
    Consistent ext h (x, true) ↔ x ∈ ext h :=
  iff_true_right rfl

/-- A hypothesis is consistent with a negatively labeled instance iff the instance does not lie
in its extension. -/
@[simp]
theorem consistent_false {ext : H → Set X} {h : H} {x : X} :
    Consistent ext h (x, false) ↔ x ∉ ext h :=
  iff_false_right Bool.false_ne_true

/-- The version space of positive examples `P` and negative examples `N` is the version space of
the sample of labeled instances that labels the instances of `P` positive and those of `N`
negative, for the consistency relation of the extension map (Mitchell 1982). -/
theorem versionSpace_eq_lowerPolar (ext : H → Set X) (P N : Set X) :
    versionSpace ext P N = lowerPolar (Consistent ext) (P ×ˢ {true} ∪ N ×ˢ {false}) := by
  ext
  simp [versionSpace, Set.subset_def, Set.disjoint_right, mem_lowerPolar_iff]

/-! ### Version spaces of samples and extents -/

/-- The version spaces of samples are exactly the extents of the formal context
`(Θ, E, cons)`. In Mathlib an extent is by definition a set of the form `lowerPolar cons S`. -/
theorem range_lowerPolar (cons : Θ → E → Prop) :
    Set.range (lowerPolar cons) = {V | Order.IsExtent cons V} :=
  rfl

/-- A sample of labeled instances labels `true` the instances it labels `true` and `false` the
instances it labels `false`. -/
private lemma setOf_true_prod_union_setOf_false_prod (S : Set (X × Bool)) :
    {x | (x, true) ∈ S} ×ˢ {true} ∪ {x | (x, false) ∈ S} ×ˢ {false} = S := by
  ext ⟨x, b⟩
  cases b <;> simp

/-- The version spaces of an extension map, for all sets of positive and negative examples, are
exactly the extents of the formal context of hypotheses and labeled instances with the
consistency relation `Consistent ext`. -/
theorem exists_versionSpace_eq_iff_isExtent (ext : H → Set X) (V : Set H) :
    (∃ P N, versionSpace ext P N = V) ↔ Order.IsExtent (Consistent ext) V :=
  ⟨fun ⟨P, N, h⟩ => ⟨_, (versionSpace_eq_lowerPolar ext P N).symm.trans h⟩, fun ⟨S, hS⟩ =>
    ⟨_, _, (versionSpace_eq_lowerPolar ext _ _).trans
      ((congrArg _ (setOf_true_prod_union_setOf_false_prod S)).trans hS)⟩⟩

/-- The extent map is an order isomorphism from the concept lattice of the formal context
`(Θ, E, cons)` onto the version spaces of samples, ordered by inclusion. Its inverse sends a
version space to the concept with that extent (Ganter–Wille 1999). -/
def extentOrderIso (cons : Θ → E → Prop) :
    Concept Θ E cons ≃o Set.range (lowerPolar cons) where
  toFun c := ⟨c.extent, c.isExtent_extent⟩
  invFun V := Concept.ofIsExtent cons V.1 V.2
  left_inv _ := Concept.ext rfl
  right_inv _ := rfl
  map_rel_iff' := Concept.extent_subset_extent_iff

/-- The extent map sends a concept to its extent. -/
@[simp]
theorem coe_extentOrderIso_apply (cons : Θ → E → Prop) (c : Concept Θ E cons) :
    (extentOrderIso cons c : Set Θ) = c.extent :=
  rfl

/-- The inverse of the extent map sends a version space of samples to the concept with that
extent. -/
@[simp]
theorem extent_extentOrderIso_symm_apply (cons : Θ → E → Prop)
    (V : Set.range (lowerPolar cons)) : ((extentOrderIso cons).symm V).extent = V :=
  rfl

/-- There are as many version spaces of samples as formal concepts of the context
`(Θ, E, cons)`. No finiteness is needed: if there are infinitely many, both sides are `0`. -/
theorem card_range_lowerPolar (cons : Θ → E → Prop) :
    Nat.card (Set.range (lowerPolar cons)) = Nat.card (Concept Θ E cons) :=
  (Nat.card_congr (extentOrderIso cons).toEquiv).symm

/-! ### Finite samples -/

/-- If a concept is minimal among the concepts whose extent is the version space of a finite
subsample of `S`, that subsample has the version space of `S`. -/
private lemma exists_finite_subset_of_minimal {cons : Θ → E → Prop} {S : Set E}
    {c : Concept Θ E cons}
    (hc : Minimal (fun c : Concept Θ E cons => ∃ T ⊆ S, T.Finite ∧ lowerPolar cons T = c.extent)
      c) :
    ∃ T ⊆ S, T.Finite ∧ lowerPolar cons T = lowerPolar cons S := by
  obtain ⟨T, hTS, hT, hTc⟩ := hc.prop
  refine ⟨T, hTS, hT, Set.Subset.antisymm (fun θ hθ e he => ?_) (lowerPolar_anti cons hTS)⟩
  exact Concept.extent_subset_extent_iff.2 (hc.2 (y := Concept.ofAttributes cons (insert e T))
    ⟨insert e T, Set.insert_subset he hTS, hT.insert e, rfl⟩
    (Concept.extent_subset_extent_iff.1 (hTc ▸ lowerPolar_anti cons (Set.subset_insert e T))))
    (hTc ▸ hθ) (Set.mem_insert e T)

/-- The concept lattice of `(Θ, E, cons)` has no infinite descending chain iff every sample has a
finite subsample with the same version space. -/
theorem wellFoundedLT_concept_iff_exists_finite_subset (cons : Θ → E → Prop) :
    WellFoundedLT (Concept Θ E cons) ↔
      ∀ S : Set E, ∃ T ⊆ S, T.Finite ∧ lowerPolar cons T = lowerPolar cons S := by
  refine ⟨fun _ S => (exists_minimal_of_wellFoundedLT _
    ⟨⊤, ∅, Set.empty_subset S, Set.finite_empty, (lowerPolar_empty cons).trans
      Concept.extent_top.symm⟩).elim fun _ hc => exists_finite_subset_of_minimal hc,
    fun h => ⟨wellFounded_iff_isEmpty_descending_chain.2 ⟨fun ⟨f, hf⟩ => ?_⟩⟩⟩
  obtain ⟨T, hTS, hT, hTeq⟩ := h (⋃ n, (f n).intent)
  obtain ⟨T, rfl⟩ := hT.exists_finset_coe
  obtain ⟨m, hm⟩ := (Monotone.directed_le fun _ _ hnm =>
    Concept.intent_subset_intent_iff.2 ((strictAnti_nat_of_succ_lt hf).antitone hnm)
      ).exists_mem_subset_of_finset_subset_biUnion hTS
  refine (hf m).not_ge (Concept.extent_subset_extent_iff.1 ?_)
  rw [← Concept.lowerPolar_intent, ← Concept.lowerPolar_intent]
  exact (lowerPolar_anti cons hm).trans (hTeq.trans_subset
    (lowerPolar_anti cons (Set.subset_iUnion (fun n => (f n).intent) (m + 1))))

-- The chain condition is needed: if every sample has such a subsample, the concept lattice has
-- no infinite descending chain (`wellFoundedLT_concept_iff_exists_finite_subset`).
/-- If the concept lattice of `(Θ, E, cons)` has no infinite descending chain, in particular if
there are finitely many hypotheses or finitely many examples, every sample has a finite
subsample with the same version space. -/
theorem exists_finite_subset_lowerPolar_eq (cons : Θ → E → Prop)
    [WellFoundedLT (Concept Θ E cons)] (S : Set E) :
    ∃ T ⊆ S, T.Finite ∧ lowerPolar cons T = lowerPolar cons S :=
  (wellFoundedLT_concept_iff_exists_finite_subset cons).1 ‹_› S

/-- If every sample has a finite subsample with the same version space, the version spaces of
finite samples are the extents. -/
private lemma lowerPolar_image_setOf_finite_of_forall {cons : Θ → E → Prop}
    (h : ∀ S : Set E, ∃ T ⊆ S, T.Finite ∧ lowerPolar cons T = lowerPolar cons S) :
    lowerPolar cons '' {S | S.Finite} = {V | Order.IsExtent cons V} :=
  Set.Subset.antisymm (Set.image_subset_range _ _) fun _ ⟨S, hS⟩ =>
    (h S).imp fun _ ⟨_, hT, hTS⟩ => ⟨hT, hTS.trans hS⟩

-- The chain condition cannot be dropped, and the ascending chain condition does not replace it:
-- see `lowerPolar_image_setOf_finite_counterexample`. It is not necessary: adding to that example
-- an example consistent with no hypothesis makes every extent the version space of a finite
-- sample, and the descending chain `Set.Ici 0 ⊃ Set.Ici 1 ⊃ ⋯` of extents remains.
/-- If the concept lattice of `(Θ, E, cons)` has no infinite descending chain, in particular if
there are finitely many hypotheses or finitely many examples, the version spaces of finite
samples are exactly the extents of the context. -/
theorem lowerPolar_image_setOf_finite (cons : Θ → E → Prop)
    [WellFoundedLT (Concept Θ E cons)] :
    lowerPolar cons '' {S | S.Finite} = {V | Order.IsExtent cons V} :=
  lowerPolar_image_setOf_finite_of_forall (exists_finite_subset_lowerPolar_eq cons)

/-- If the version spaces of finite samples are finitely many, every sample has a finite
subsample with the same version space: some concept is minimal among the finitely many concepts
whose extent is the version space of a finite subsample. -/
private lemma exists_finite_subset_of_finite {cons : Θ → E → Prop}
    (h : (lowerPolar cons '' {S | S.Finite}).Finite) (S : Set E) :
    ∃ T ⊆ S, T.Finite ∧ lowerPolar cons T = lowerPolar cons S :=
  ((Set.Finite.of_finite_image
    (s := {c : Concept Θ E cons | ∃ T ⊆ S, T.Finite ∧ lowerPolar cons T = c.extent})
    (h.subset fun _ ⟨_, ⟨T, _, hT, hTc⟩, he⟩ => ⟨T, hT, hTc.trans he⟩)
    Concept.extent_injective.injOn).exists_minimal
      ⟨⊤, ∅, Set.empty_subset S, Set.finite_empty, (lowerPolar_empty cons).trans
        Concept.extent_top.symm⟩).elim fun _ hc => exists_finite_subset_of_minimal hc

/-- There are as many version spaces of finite samples as formal concepts of `(Θ, E, cons)`. No
chain condition is needed: if the version spaces of finite samples are finitely many, every
extent is one of them, and otherwise both sides are `0`. -/
theorem card_lowerPolar_image_setOf_finite (cons : Θ → E → Prop) :
    Nat.card (lowerPolar cons '' {S | S.Finite}) = Nat.card (Concept Θ E cons) := by
  rw [← card_range_lowerPolar]
  rcases (lowerPolar cons '' {S | S.Finite}).finite_or_infinite with h | h
  · rw [lowerPolar_image_setOf_finite_of_forall (exists_finite_subset_of_finite h),
      ← range_lowerPolar]
  · rw [h.card_eq_zero, (h.mono (Set.image_subset_range _ _)).card_eq_zero]

/-- In the context `(ℕ, ℕ, fun θ e => e ≤ θ)` the intent of a concept with an object `θ` in its
extent lies in `{e | e ≤ θ}`, so the number of attributes in the intent strictly decreases along
the concept order. -/
private lemma strictAnti_encard_intent :
    StrictAnti fun c : Concept ℕ ℕ (fun θ e => e ≤ θ) => c.intent.encard := fun _ _ hcd => by
  obtain ⟨θ, hθ, -⟩ := Set.exists_of_ssubset (Concept.extent_ssubset_extent_iff.2 hcd)
  exact Set.Finite.encard_lt_encard
    ((Set.finite_le_nat θ).subset fun _ => Concept.rel_extent_intent hθ)
    (Concept.intent_ssubset_intent_iff.2 hcd)

/-- The version spaces of finite samples need not be all the extents. For the consistency
relation `e ≤ θ` on the natural numbers the version space of a sample is its set of upper bounds.
The empty set is an extent, the version space of the sample of all natural numbers, but every
finite sample has an upper bound. This concept lattice has no infinite ascending chain, so the
descending chain condition in `lowerPolar_image_setOf_finite` cannot be replaced by the
ascending one. -/
theorem lowerPolar_image_setOf_finite_counterexample :
    WellFoundedGT (Concept ℕ ℕ fun θ e => e ≤ θ) ∧ Order.IsExtent (fun θ e : ℕ => e ≤ θ) ∅ ∧
      ∅ ∉ lowerPolar (fun θ e : ℕ => e ≤ θ) '' {S | S.Finite} :=
  ⟨strictAnti_encard_intent.wellFoundedGT,
    ⟨Set.univ, Set.eq_empty_of_forall_notMem fun θ hθ => θ.not_succ_le_self (hθ (Set.mem_univ _))⟩,
    fun ⟨_, hS, hSe⟩ => hS.bddAbove.ne_empty hSe⟩

/-! ### Least elements of version spaces from a lower adjoint -/

section GaloisConnection

variable [Preorder H] {ext : H → Set X} {gen : Set X → H} {P N : Set X}

/-- If the extension map has a lower adjoint `gen`, sending a set of instances to the least
hypothesis whose extension contains it, the version space of positive examples `P` and negative
examples `N` is nonempty iff the extension of `gen P` contains no negative example. -/
theorem nonempty_versionSpace_iff_of_galoisConnection (hgc : GaloisConnection gen ext) :
    (versionSpace ext P N).Nonempty ↔ Disjoint (ext (gen P)) N :=
  ⟨fun ⟨_, hP, hN⟩ => hN.mono_left (hgc.monotone_u (hgc.l_le hP)),
    fun h => ⟨gen P, hgc.le_u_l P, h⟩⟩

/-- If the extension map has a lower adjoint `gen`, the version space of positive examples `P` and
negative examples `N` consists of the hypotheses above `gen P` whose extension contains no negative
example: a hypothesis has every positive example in its extension exactly when it lies above
`gen P`. No chain condition is needed. -/
theorem versionSpace_eq_Ici_inter_of_galoisConnection (hgc : GaloisConnection gen ext) :
    versionSpace ext P N = Set.Ici (gen P) ∩ {h | Disjoint (ext h) N} :=
  Set.ext fun h => and_congr_left' (hgc P h).symm

-- The lower adjoint is needed: in the lattice `⊥ < a, b < ⊤` with `ext ⊥ = ∅` and
-- `ext a = ext b = ext ⊤ = {x}`, which has none, the version space of `P = {x}` and `N = ∅` is
-- `{a, b, ⊤}`, with no least element. Nonemptiness is needed: `∅` has no least element.
/-- If the extension map has a lower adjoint `gen`, a nonempty version space of positive examples
`P` has least element `gen P`, the least hypothesis whose extension contains `P`. -/
theorem isLeast_versionSpace_of_galoisConnection (hgc : GaloisConnection gen ext)
    (hne : (versionSpace ext P N).Nonempty) : IsLeast (versionSpace ext P N) (gen P) :=
  ⟨⟨hgc.le_u_l P, (nonempty_versionSpace_iff_of_galoisConnection hgc).1 hne⟩,
    fun _ hh => hgc.l_le hh.1⟩

end GaloisConnection

/-! ### Version spaces in a concept lattice -/

section Concept

variable {r : α → β → Prop} {Q N : Set α}

/-- The concept generated by a set of objects is the least concept whose extent contains it:
`Concept.ofObjects r` is a lower adjoint of the extent map. -/
theorem gc_ofObjects_extent (r : α → β → Prop) :
    GaloisConnection (Concept.ofObjects r) (Concept.extent : Concept α β r → Set α) :=
  fun _ _ => Concept.ofObjects_le_iff

/-- The concepts of a formal context consistent with positive objects `Q` and negative objects
`N`, that is the concepts whose extent contains `Q` and misses `N`, form an order-convex set
(Mitchell 1982). -/
theorem versionSpace_extent_ordConnected (r : α → β → Prop) (Q N : Set α) :
    (versionSpace (Concept.extent : Concept α β r → Set α) Q N).OrdConnected :=
  versionSpace_ordConnected Concept.strictMono_extent.monotone Q N

/-- Some concept of a formal context is consistent with positive objects `Q` and negative objects
`N` iff the extent of the concept generated by `Q` misses `N`. -/
theorem nonempty_versionSpace_extent_iff :
    (versionSpace (Concept.extent : Concept α β r → Set α) Q N).Nonempty ↔
      Disjoint (Concept.ofObjects r Q).extent N :=
  nonempty_versionSpace_iff_of_galoisConnection (gc_ofObjects_extent r)

/-- If some concept of a formal context is consistent with positive objects `Q` and negative
objects `N`, the concept generated by `Q` is the least concept consistent with them. -/
theorem isLeast_ofObjects_versionSpace
    (hne : (versionSpace (Concept.extent : Concept α β r → Set α) Q N).Nonempty) :
    IsLeast (versionSpace Concept.extent Q N) (Concept.ofObjects r Q) :=
  isLeast_versionSpace_of_galoisConnection (gc_ofObjects_extent r) hne

end Concept

end MathlibLattice.VersionSpace
