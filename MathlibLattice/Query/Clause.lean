import MathlibLattice.Query.Corpus
import MathlibLattice.Term.Hypothesis

-- The library's files carry no copyright header.
set_option linter.style.header false

/-!
# The generalization query over a corpus of clauses

A corpus of conditional statements `τ : G → Clause L α`, each read as a clause with its conclusions
as positive and its hypotheses as negative literals, gives the subsumption context
`(G, Clause L α, fun g C => Subsumes C (τ g))`: the statement `g` has the description `C` when `C`
θ-subsumes the clause of `g`, that is, when `C` generalizes `g`. Relative to background clauses
`B`, such as the clauses `Ring(x) ← Field(x)` of a hierarchy of algebraic structures, it gives the
relative context `fun g C => RelSubsumes B C (τ g)`. These are the query over a corpus in the
preorders `Subsumption L α` and `RelSubsumption B α`.

If `u` is a least general generalization of the clauses of the positive statements `Q`, the
concept generated by `Q` is the attribute concept of `u`. Hence answers exist if and only if no
negative statement is subsumed by `u`, the least answer is then the concept of `u`, and the
certain predictions are the statements subsumed by `u`. For two positive statements, `u` is the
clause computed by anti-unification (Plotkin 1970), and every nonempty finite set of clauses has
such a `u` when `α` is infinite or empty. Relative to `B`, two clauses with finite saturations
have as `u` the anti-unifier of their saturations (Plotkin 1971), and for backgrounds with finite
saturations, such as finite typeclass hierarchies, every finite set of clauses has one.

The meet of the concepts of two clauses with disjoint variables is the concept of their union. So
in a finite corpus, when `α` is infinite or empty, every concept is the attribute concept of a
clause, and the answers are the concepts of the clauses subsuming every positive statement and no
negative one, with no least general generalization needed; the same holds relative to `B`.

Generalization is sound: a clause holding in a structure `M` generalizes only statements holding
in `M`. So if a common generalization of the positive statements holds in a model `M` of `B` and
every negative statement is refuted in `M`, its concept is an answer, and answers exist.

## Main statements

* `intent_ofObjects_subsumes`, `extent_ofObjects_subsumes`, `ofObjects_subsumes_eq_ofAttribute`,
  `exists_ofObjects_subsumes_eq_ofAttribute`: the concept generated by `Q` is the concept of the
  least general generalization of its clauses.
* `nonempty_consistentConcepts_subsumes_iff`, `isLeast_ofAttribute_subsumes`,
  `certainPredictions_subsumes_eq`: existence of answers, the least answer and the certain
  predictions.
* `ofObjects_pair_subsumes_eq_ofAttribute_lgg`, `nonempty_consistentConcepts_pair_subsumes_iff`,
  `isLeast_ofAttribute_lgg`, `exists_ofObjects_pair_subsumes_eq_ofAttribute_lgg`: two positive
  statements, answered by anti-unification.
* `ofAttribute_inf_ofAttribute_subsumes`, `exists_eq_ofAttribute_subsumes`,
  `consistentConcepts_subsumes_eq_image`, `maximalConsistentConcepts_subsumes_eq`: in a finite
  corpus every concept, every answer and every most general answer is the concept of a clause.
* `ofObjects_relSubsumes_eq_ofAttribute`, `nonempty_consistentConcepts_relSubsumes_iff`,
  `isLeast_ofAttribute_relSubsumes`, `certainPredictions_relSubsumes_eq`,
  `ofAttribute_inf_ofAttribute_relSubsumes`, `exists_eq_ofAttribute_relSubsumes`,
  `consistentConcepts_relSubsumes_eq_image`, `maximalConsistentConcepts_relSubsumes_eq`: the same
  relative to background clauses.
* `ofObjects_pair_relSubsumes_eq_ofAttribute_lgg`,
  `nonempty_consistentConcepts_pair_relSubsumes_iff`,
  `exists_ofObjects_relSubsumes_eq_ofAttribute_of_flat`: the least answer relative to background
  clauses, from the saturations.
* `ofAttribute_mem_consistentConcepts_of_sound`, `ofAttribute_mem_consistentConcepts_of_holds`,
  `ofAttribute_mem_consistentConcepts_of_holds_relSubsumes`: a true common generalization of the
  positive statements gives an answer when the negative statements are refuted.

## References

* G. D. Plotkin, *A note on inductive generalization*, 1970.
* G. D. Plotkin, *A further note on inductive generalization*, 1971.
* T. M. Mitchell, *Generalization as search*, Artificial Intelligence 18, 1982.
-/

namespace MathlibLattice.Query

open FirstOrder Language MathlibLattice.Term

universe u₁ u₂ u₃

variable {L : Language.{u₁, u₂}} {α : Type u₃} {G : Type*} {τ : G → Clause L α} {Q N : Set G}
  {u : Clause L α}

/-! ### The concept generated by the positive statements -/

/-- In the subsumption context of a corpus of clauses, the descriptions common to the statements
of `Q` are the generalizations of a least general generalization `u` of their clauses. No
nonemptiness of `Q` is needed. -/
theorem intent_ofObjects_subsumes (hu : IsLUB (toSubsumption '' (τ '' Q)) (toSubsumption u)) :
    (Concept.ofObjects (fun g (C : Clause L α) => Subsumes C (τ g)) Q).intent =
      {C | Subsumes C u} :=
  intent_ofObjects_of_isLUB (τ := fun g => toSubsumption (τ g)) ((Set.image_image _ _ _).symm ▸ hu)

/-- In the subsumption context of a corpus of clauses, the extent of the concept generated by `Q`
is the set of statements subsumed by a least general generalization `u` of the clauses of `Q`.
No nonemptiness of `Q` is needed. -/
theorem extent_ofObjects_subsumes (hu : IsLUB (toSubsumption '' (τ '' Q)) (toSubsumption u)) :
    (Concept.ofObjects (fun g (C : Clause L α) => Subsumes C (τ g)) Q).extent =
      {g | Subsumes u (τ g)} :=
  extent_ofObjects_of_isLUB (τ := fun g => toSubsumption (τ g)) ((Set.image_image _ _ _).symm ▸ hu)

/-- In the subsumption context of a corpus of clauses, the concept generated by `Q` is the
attribute concept of a least general generalization `u` of the clauses of `Q`. This is
`ofObjects_eq_ofAttribute_of_isLUB` in the preorder `Subsumption L α`. -/
theorem ofObjects_subsumes_eq_ofAttribute
    (hu : IsLUB (toSubsumption '' (τ '' Q)) (toSubsumption u)) :
    Concept.ofObjects (fun g (C : Clause L α) => Subsumes C (τ g)) Q =
      Concept.ofAttribute _ u :=
  ofObjects_eq_ofAttribute_of_isLUB (τ := fun g => toSubsumption (τ g))
    ((Set.image_image _ _ _).symm ▸ hu)

-- `hα` is needed: over `n ≥ 1` variables two clauses can lack a least general generalization
-- (`Subsumption.exists_isLUB_pair`). `hQ` is needed: with a unary relation symbol `P` and a unary
-- function symbol `f`, no clause is subsumed by every unit clause `{P(fᵏ(x))}`, so `∅` has no
-- least upper bound. `hQfin` is needed, by the directed cycles of `Subsumption.exists_isLUB`.
/-- If `α` is infinite or empty, the clauses of a nonempty finite set `Q` of statements have a
least general generalization `u` (`Subsumption.exists_isLUB`, Plotkin 1970), and the concept
generated by `Q` is the attribute concept of `u`. -/
theorem exists_ofObjects_subsumes_eq_ofAttribute (hα : Finite α → IsEmpty α) (hQ : Q.Nonempty)
    (hQfin : Q.Finite) :
    ∃ u : Clause L α, IsLUB (toSubsumption '' (τ '' Q)) (toSubsumption u) ∧
      Concept.ofObjects (fun g (C : Clause L α) => Subsumes C (τ g)) Q =
        Concept.ofAttribute _ u :=
  (Subsumption.exists_isLUB hα ((hQ.image _).image _) ((hQfin.image _).image _)).imp
    fun _ hu => ⟨hu, ofObjects_subsumes_eq_ofAttribute hu⟩

/-! ### Answers -/

/-- In the subsumption context of a corpus of clauses, some concept is consistent with the
positive statements `Q` and the negative statements `N` if and only if no negative statement is
subsumed by a least general generalization `u` of the clauses of `Q`. -/
theorem nonempty_consistentConcepts_subsumes_iff
    (hu : IsLUB (toSubsumption '' (τ '' Q)) (toSubsumption u)) :
    (consistentConcepts (fun g (C : Clause L α) => Subsumes C (τ g)) Q N).Nonempty ↔
      ∀ g ∈ N, ¬Subsumes u (τ g) :=
  nonempty_consistentConcepts_iff_of_isLUB (τ := fun g => toSubsumption (τ g))
    ((Set.image_image _ _ _).symm ▸ hu)

/-- In the subsumption context of a corpus of clauses, if no negative statement is subsumed by a
least general generalization `u` of the clauses of `Q`, the attribute concept of `u` is the least
consistent concept: the least general answer is the concept of the clause `u`. -/
theorem isLeast_ofAttribute_subsumes (hu : IsLUB (toSubsumption '' (τ '' Q)) (toSubsumption u))
    (hN : ∀ g ∈ N, ¬Subsumes u (τ g)) :
    IsLeast (consistentConcepts (fun g (C : Clause L α) => Subsumes C (τ g)) Q N)
      (Concept.ofAttribute _ u) :=
  isLeast_ofAttribute_of_isLUB (τ := fun g => toSubsumption (τ g))
    ((Set.image_image _ _ _).symm ▸ hu) hN

-- The hypothesis `hN` is needed: for the corpus of the clauses `{P(c)}` and `{P(d)}` of two
-- distinct constants, `u = {P(c)}` and `Q = N` the first statement, no concept is consistent, so
-- both statements are certain predictions, while only the first is subsumed by `u`.
/-- In the subsumption context of a corpus of clauses, if no negative statement is subsumed by a
least general generalization `u` of the clauses of `Q`, the certain predictions are the
statements of the corpus subsumed by `u`. -/
theorem certainPredictions_subsumes_eq
    (hu : IsLUB (toSubsumption '' (τ '' Q)) (toSubsumption u))
    (hN : ∀ g ∈ N, ¬Subsumes u (τ g)) :
    certainPredictions (fun g (C : Clause L α) => Subsumes C (τ g)) Q N =
      {g | Subsumes u (τ g)} :=
  certainPredictions_eq_of_isLUB (τ := fun g => toSubsumption (τ g))
    ((Set.image_image _ _ _).symm ▸ hu) hN

/-! ### Two positive statements -/

/-- A least upper bound of `f (τ g₁)` and `f (τ g₂)` is one of the image of `{g₁, g₂}`. -/
private lemma isLUB_image_image_pair {P : Type*} [Preorder P] {f : Clause L α → P} {g₁ g₂ : G}
    {x : P} (h : IsLUB {f (τ g₁), f (τ g₂)} x) : IsLUB (f '' (τ '' {g₁, g₂})) x := by
  rwa [Set.image_pair, Set.image_pair]

/-- Anti-unification answers the query for two positive statements (Plotkin 1970): if `ν` names
the disagreement pairs of their clauses injectively, the concept generated by the two statements
is the attribute concept of the least general generalization `Clause.lgg ν (τ g₁) (τ g₂)` of their
clauses (`isLUB_clauseLgg`). -/
theorem ofObjects_pair_subsumes_eq_ofAttribute_lgg {ν : L.Term α × L.Term α → α} {g₁ g₂ : G}
    (hν : Set.InjOn ν ((τ g₁).antiUnify (τ g₂)).varSet) :
    Concept.ofObjects (fun g (C : Clause L α) => Subsumes C (τ g)) {g₁, g₂} =
      Concept.ofAttribute _ (Clause.lgg ν (τ g₁) (τ g₂)) :=
  ofObjects_subsumes_eq_ofAttribute (isLUB_image_image_pair (isLUB_clauseLgg hν))

/-- For two positive statements whose clauses have their disagreement pairs named injectively by
`ν`, some concept is consistent with them and the negative statements `N` if and only if no
negative statement is subsumed by the least general generalization `Clause.lgg ν (τ g₁) (τ g₂)`. -/
theorem nonempty_consistentConcepts_pair_subsumes_iff {ν : L.Term α × L.Term α → α}
    {g₁ g₂ : G} (hν : Set.InjOn ν ((τ g₁).antiUnify (τ g₂)).varSet) :
    (consistentConcepts (fun g (C : Clause L α) => Subsumes C (τ g)) {g₁, g₂} N).Nonempty ↔
      ∀ g ∈ N, ¬Subsumes (Clause.lgg ν (τ g₁) (τ g₂)) (τ g) :=
  nonempty_consistentConcepts_subsumes_iff (isLUB_image_image_pair (isLUB_clauseLgg hν))

/-- For two positive statements whose clauses have their disagreement pairs named injectively by
`ν`, if no negative statement is subsumed by `Clause.lgg ν (τ g₁) (τ g₂)`, the attribute concept
of this clause is the least answer. -/
theorem isLeast_ofAttribute_lgg {ν : L.Term α × L.Term α → α} {g₁ g₂ : G}
    (hν : Set.InjOn ν ((τ g₁).antiUnify (τ g₂)).varSet)
    (hN : ∀ g ∈ N, ¬Subsumes (Clause.lgg ν (τ g₁) (τ g₂)) (τ g)) :
    IsLeast (consistentConcepts (fun g (C : Clause L α) => Subsumes C (τ g)) {g₁, g₂} N)
      (Concept.ofAttribute _ (Clause.lgg ν (τ g₁) (τ g₂))) :=
  isLeast_ofAttribute_subsumes (isLUB_image_image_pair (isLUB_clauseLgg hν)) hN

-- `Infinite α` is needed: over `n` variables, for the clauses `{P(a, …, a)}` and
-- `{P(c₀, …, cₙ)}`, no `Clause.lgg ν` subsumes the second clause (`exists_isLUB_clauseLgg`), so
-- its attribute concept does not contain the second statement.
/-- With infinitely many variables, the concept generated by two statements is the attribute
concept of a least general generalization of their clauses computed by anti-unification
(`exists_isLUB_clauseLgg`, Plotkin 1970). -/
theorem exists_ofObjects_pair_subsumes_eq_ofAttribute_lgg [Infinite α] (g₁ g₂ : G) :
    ∃ ν : L.Term α × L.Term α → α,
      Concept.ofObjects (fun g (C : Clause L α) => Subsumes C (τ g)) {g₁, g₂} =
        Concept.ofAttribute _ (Clause.lgg ν (τ g₁) (τ g₂)) :=
  (exists_isLUB_clauseLgg (τ g₁) (τ g₂)).imp fun _ hν =>
    ofObjects_subsumes_eq_ofAttribute (isLUB_image_image_pair hν)

/-! ### Finite corpora -/

/-- A substitution acts on a term through the variables occurring in it. -/
private lemma subst_congr {γ : Type*} {σ σ' : α → L.Term γ} {t : L.Term α}
    (h : ∀ x ∈ varSet t, σ x = σ' x) : t.subst σ = t.subst σ' := by
  induction t with
  | var x => exact h x rfl
  | func f ts ih => exact congrArg (Term.func f) (funext fun i =>
      ih i fun x hx => h x (Set.mem_iUnion.2 ⟨i, hx⟩))

/-- A substitution acts on an atom through the variables occurring in it. -/
private lemma atom_subst_congr {γ : Type*} {σ σ' : α → L.Term γ} {a : Atom L α}
    (h : ∀ x ∈ a.varSet, σ x = σ' x) : a.subst σ = a.subst σ' :=
  congrArg (Atom.mk a.rel) (funext fun i => subst_congr fun x hx => h x (Set.mem_iUnion.2 ⟨i, hx⟩))

/-- A substitution acts on a literal through the variables occurring in it. -/
private lemma literal_subst_congr {γ : Type*} {σ σ' : α → L.Term γ} {l : Literal L α}
    (h : ∀ x ∈ l.atom.varSet, σ x = σ' x) : l.subst σ = l.subst σ' := by
  cases l with
  | pos a => exact congrArg Literal.pos (atom_subst_congr h)
  | neg a => exact congrArg Literal.neg (atom_subst_congr h)

open scoped Classical in
/-- Two clauses with disjoint variables both subsume a clause exactly when their union does. -/
private lemma subsumes_union_iff {C D E : Clause L α} (h : Disjoint C.varSet D.varSet) :
    Subsumes (C ∪ D) E ↔ Subsumes C E ∧ Subsumes D E := by
  refine ⟨fun hE => ⟨(Subsumes.of_subset Finset.subset_union_left).trans hE,
    (Subsumes.of_subset Finset.subset_union_right).trans hE⟩,
    fun ⟨⟨θ₁, h₁⟩, ⟨θ₂, h₂⟩⟩ => ⟨fun x => if x ∈ C.varSet then θ₁ x else θ₂ x, fun l hl => ?_⟩⟩
  rcases Finset.mem_union.1 hl with hl | hl
  · rw [literal_subst_congr (σ' := θ₁) fun x hx =>
      if_pos (show x ∈ C.varSet from Set.mem_iUnion₂.2 ⟨l, hl, hx⟩)]
    exact h₁ l hl
  · rw [literal_subst_congr (σ' := θ₂) fun x hx =>
      if_neg (Set.disjoint_right.1 h (show x ∈ D.varSet from Set.mem_iUnion₂.2 ⟨l, hl, hx⟩))]
    exact h₂ l hl

open scoped Classical in
-- `h` is needed: for `C = {P(x)}`, `D = {Q(x)}` and the statement `{P(a), Q(b)}`, both clauses
-- subsume the statement and their union does not.
/-- The meet of the concepts of two clauses with disjoint variables is the concept of their
union: a statement is subsumed by both clauses exactly when it is subsumed by their union. So up
to renaming variables apart, the attribute concepts of the subsumption context are closed under
binary meets. -/
theorem ofAttribute_inf_ofAttribute_subsumes {C D : Clause L α}
    (h : Disjoint C.varSet D.varSet) :
    Concept.ofAttribute (fun g (E : Clause L α) => Subsumes E (τ g)) C ⊓
        Concept.ofAttribute _ D = Concept.ofAttribute _ (C ∪ D) := by
  ext g
  simp [subsumes_union_iff, h]

/-- A term has finitely many variables. -/
private lemma finite_varSet (t : L.Term α) : (varSet t).Finite := by
  induction t with
  | var x => exact Set.finite_singleton x
  | func f ts ih => exact Set.finite_iUnion ih

/-- A clause has finitely many variables. -/
private lemma finite_clause_varSet (C : Clause L α) : C.varSet.Finite :=
  C.finite_toSet.biUnion fun l _ => Set.finite_iUnion fun i => finite_varSet (l.atom.args i)

/-- Renaming the variables of a term along `f` renames its set of variables along `f`. -/
private lemma varSet_subst_var_comp (f : α → α) (t : L.Term α) :
    varSet (t.subst (Term.var ∘ f)) = f '' varSet t := by
  induction t with
  | var x => exact Set.image_singleton.symm
  | func g ts ih => exact (Set.iUnion_congr ih).trans Set.image_iUnion.symm

/-- Renaming the variables of a literal along `f` renames its set of variables along `f`. -/
private lemma varSet_atom_subst_var_comp (f : α → α) (l : Literal L α) :
    (l.subst (Term.var ∘ f)).atom.varSet = f '' l.atom.varSet := by
  cases l <;>
    exact (Set.iUnion_congr fun i => varSet_subst_var_comp f _).trans Set.image_iUnion.symm

/-- Renaming a literal along `f`, injective on its variables, then along `invFunOn f` fixes it. -/
private lemma subst_invFunOn_subst [Nonempty α] {f : α → α} {s : Set α}
    (hf : Set.InjOn f s) {l : Literal L α} (hl : l.atom.varSet ⊆ s) :
    (l.subst (Term.var ∘ f)).subst (Term.var ∘ Function.invFunOn f s) = l :=
  (Literal.subst_subst l _ _).trans ((literal_subst_congr fun _ hx =>
    congrArg Term.var (hf.leftInvOn_invFunOn (hl hx))).trans (Literal.subst_var l))

open scoped Classical in
/-- With infinitely many or no variables, a clause is equivalent to one avoiding a finite set. -/
private lemma exists_disjoint_varSet (hα : Finite α → IsEmpty α) {W : Set α}
    (hW : W.Finite) (C : Clause L α) :
    ∃ C' : Clause L α, Disjoint C'.varSet W ∧ Subsumes C C' ∧ Subsumes C' C := by
  rcases finite_or_infinite α with h | h
  · exact ⟨C, Set.disjoint_left.2 fun x => (hα h).elim x, Subsumes.refl C, Subsumes.refl C⟩
  obtain ⟨f, hfW, hf⟩ := (finite_clause_varSet C).exists_injOn_of_encard_le (t := Wᶜ)
    (hW.infinite_compl.encard_eq ▸ le_top)
  refine ⟨C.image fun l => l.subst (Term.var ∘ f), Set.disjoint_left.2 fun x hx hxW => ?_,
    ⟨Term.var ∘ f, fun l hl => Finset.mem_image_of_mem _ hl⟩,
    ⟨Term.var ∘ Function.invFunOn f C.varSet, fun l' hl' => ?_⟩⟩
  · obtain ⟨l', hl', hx⟩ := Set.mem_iUnion₂.1 hx
    obtain ⟨l, hl, rfl⟩ := Finset.mem_image.1 hl'
    obtain ⟨y, hy, rfl⟩ := (varSet_atom_subst_var_comp f l).subset hx
    exact hfW (Set.mem_iUnion₂.2 ⟨l, hl, hy⟩) hxW
  · obtain ⟨l, hl, rfl⟩ := Finset.mem_image.1 hl'
    rwa [subst_invFunOn_subst (s := C.varSet) hf fun _ hx =>
      Set.mem_iUnion₂.2 ⟨l, hl, hx⟩]

open scoped Classical in
/-- Under these hypotheses on `R`, a finite set of clauses is `R`-equivalent to a single clause. -/
private lemma exists_forall_iff_of_finite {R : Clause L α → Clause L α → Prop}
    (hα : Finite α → IsEmpty α) (h0 : ∀ X, R ∅ X)
    (hmono : ∀ {C C' X}, Subsumes C' C → R C X → R C' X)
    (hunion : ∀ {C D}, Disjoint C.varSet D.varSet → ∀ X, R (C ∪ D) X ↔ R C X ∧ R D X)
    {F : Set (Clause L α)} (hF : F.Finite) : ∃ U, ∀ X, R U X ↔ ∀ C ∈ F, R C X := by
  induction F, hF using Set.Finite.induction_on with
  | empty => exact ⟨∅, fun X => by simp [h0]⟩
  | @insert C F _ _ ih =>
    obtain ⟨U, hU⟩ := ih
    obtain ⟨C', hC', hCC', hC'C⟩ := exists_disjoint_varSet hα (finite_clause_varSet U) C
    exact ⟨C' ∪ U, fun X => (hunion hC' X).trans ((and_congr ⟨hmono hCC', hmono hC'C⟩ (hU X)).trans
      (Set.forall_mem_insert (P := (R · X))).symm)⟩

/-- With finitely many objects, the extent of a concept is cut out by finitely many attributes. -/
private lemma exists_finite_lowerPolar_eq_extent {X : Type*} {r : G → X → Prop} [Finite G]
    (c : Concept G X r) : ∃ F : Set X, F.Finite ∧ lowerPolar r F = c.extent := by
  choose f hfc hfr using fun g : {g // g ∉ c.extent} =>
    not_forall₂.1 (c.lowerPolar_intent.symm ▸ g.2 : g.1 ∉ lowerPolar r c.intent)
  refine ⟨Set.range f, Set.finite_range f,
    Set.Subset.antisymm (fun g hg => ?_) fun g hg _ ⟨g', hg'⟩ =>
      hg' ▸ c.rel_extent_intent hg (hfc g')⟩
  by_contra hge
  exact hfr ⟨g, hge⟩ (hg ⟨⟨g, hge⟩, rfl⟩)

open scoped Classical in
/-- Under these hypotheses on `R`, every concept of a finite corpus is an attribute concept. -/
private lemma exists_eq_ofAttribute_of_finite [Finite G] {R : Clause L α → Clause L α → Prop}
    (hα : Finite α → IsEmpty α) (h0 : ∀ X, R ∅ X)
    (hmono : ∀ {C C' X}, Subsumes C' C → R C X → R C' X)
    (hunion : ∀ {C D}, Disjoint C.varSet D.varSet → ∀ X, R (C ∪ D) X ↔ R C X ∧ R D X)
    (c : Concept G (Clause L α) fun g C => R C (τ g)) :
    ∃ C : Clause L α, c = Concept.ofAttribute _ C := by
  obtain ⟨F, hF, hFc⟩ := exists_finite_lowerPolar_eq_extent c
  obtain ⟨U, hU⟩ := exists_forall_iff_of_finite hα h0 hmono hunion hF
  exact ⟨U, Concept.ext (hFc.symm.trans (by ext g; simp [hU, mem_lowerPolar_iff]))⟩

-- `Finite G` is needed: for the corpus of the directed cycles `{P(c₀, c₁), …, P(cₚ₋₁, c₀)}` of all
-- prime lengths `p`, on disjoint sets of constants, and of the directed paths
-- `{P(x₀, x₁), …, P(xₖ₋₁, xₖ)}` of all lengths, the cycles form an extent, the statements subsumed
-- by every common generalization of the cycles, while every clause subsuming all cycles subsumes
-- a path. `hα` is needed: over `n ≥ 1` variables, for the corpus of `{P₀(a₀), …, Pₙ(aₙ)}`,
-- `{P₀(b₀), …, Pₙ(bₙ)}` and the clauses `{Pᵢ(c) | i ≠ j}` for `j ≤ n`, the first two statements
-- form an extent, while a clause subsuming both mentions at most `n` of the `Pᵢ`, and so subsumes
-- one of the others.
/-- In the subsumption context of a finite corpus of clauses, every concept is the attribute
concept of a clause, provided `α` is infinite or empty: the extent of a concept is the set of
statements subsumed by finitely many clauses of its intent, hence by their union after renaming
their variables apart (`ofAttribute_inf_ofAttribute_subsumes`). No least general generalization
is needed. -/
theorem exists_eq_ofAttribute_subsumes [Finite G] (hα : Finite α → IsEmpty α)
    (c : Concept G (Clause L α) fun g C => Subsumes C (τ g)) :
    ∃ C : Clause L α, c = Concept.ofAttribute _ C :=
  exists_eq_ofAttribute_of_finite hα (fun X => Subsumes.of_subset X.empty_subset)
    (fun h hX => h.trans hX) (fun h _ => subsumes_union_iff h) c

-- The hypotheses are needed, by the examples of `exists_eq_ofAttribute_subsumes`: there a
-- consistent concept is no attribute concept.
/-- In the subsumption context of a finite corpus of clauses, when `α` is infinite or empty, the
answers to the query are described by clauses: the consistent concepts are the attribute concepts
of the clauses subsuming every positive statement and no negative statement
(`exists_eq_ofAttribute_subsumes`, `consistentConcepts_eq_image_ofAttribute_upperBounds_iff`). No
nonemptiness of `Q` is needed. -/
theorem consistentConcepts_subsumes_eq_image [Finite G] (hα : Finite α → IsEmpty α) :
    consistentConcepts (fun g (C : Clause L α) => Subsumes C (τ g)) Q N =
      Concept.ofAttribute _ '' {C | (∀ g ∈ Q, Subsumes C (τ g)) ∧ ∀ g ∈ N, ¬Subsumes C (τ g)} :=
  consistentConcepts_eq_image_ofAttribute_iff.2 fun c _ =>
    (exists_eq_ofAttribute_subsumes hα c).imp fun _ => Eq.symm

-- The hypotheses are needed, by the examples of `exists_eq_ofAttribute_subsumes` with the
-- clauses outside the extent negative: there the only consistent concept is no attribute concept,
-- so the left side has one element and the right side is empty.
/-- In the subsumption context of a finite corpus of clauses, when `α` is infinite or empty, the
most general answers are the maximal attribute concepts of the clauses subsuming every positive
statement and no negative statement. -/
theorem maximalConsistentConcepts_subsumes_eq [Finite G] (hα : Finite α → IsEmpty α) :
    maximalConsistentConcepts (fun g (C : Clause L α) => Subsumes C (τ g)) Q N =
      {c | Maximal (· ∈ Concept.ofAttribute _ ''
        {C | (∀ g ∈ Q, Subsumes C (τ g)) ∧ ∀ g ∈ N, ¬Subsumes C (τ g)}) c} :=
  maximalConsistentConcepts_eq_of_subset_range_ofAttribute fun c _ =>
    (exists_eq_ofAttribute_subsumes hα c).imp fun _ => Eq.symm

/-! ### Subsumption relative to background clauses -/

section Relative

variable {β : Type*} {B : Set (Clause L β)}

/-- In the context relating statements to the clauses subsuming them relative to background
clauses `B`, the descriptions common to the statements of `Q` are the relative generalizations of
a least general generalization `u` of their clauses relative to `B`. No nonemptiness of `Q` is
needed. -/
theorem intent_ofObjects_relSubsumes
    (hu : IsLUB (toRelSubsumption B '' (τ '' Q)) (toRelSubsumption B u)) :
    (Concept.ofObjects (fun g (C : Clause L α) => RelSubsumes B C (τ g)) Q).intent =
      {C | RelSubsumes B C u} :=
  intent_ofObjects_of_isLUB (τ := fun g => toRelSubsumption B (τ g))
    ((Set.image_image _ _ _).symm ▸ hu)

/-- Relative to background clauses `B`, the extent of the concept generated by `Q` is the set of
statements subsumed relative to `B` by a least general generalization `u` of the clauses of `Q`
relative to `B`. -/
theorem extent_ofObjects_relSubsumes
    (hu : IsLUB (toRelSubsumption B '' (τ '' Q)) (toRelSubsumption B u)) :
    (Concept.ofObjects (fun g (C : Clause L α) => RelSubsumes B C (τ g)) Q).extent =
      {g | RelSubsumes B u (τ g)} :=
  extent_ofObjects_of_isLUB (τ := fun g => toRelSubsumption B (τ g))
    ((Set.image_image _ _ _).symm ▸ hu)

/-- Relative to background clauses `B`, the concept generated by `Q` is the attribute concept of
a least general generalization `u` of the clauses of `Q` relative to `B`. This is
`ofObjects_eq_ofAttribute_of_isLUB` in the preorder `RelSubsumption B α`. -/
theorem ofObjects_relSubsumes_eq_ofAttribute
    (hu : IsLUB (toRelSubsumption B '' (τ '' Q)) (toRelSubsumption B u)) :
    Concept.ofObjects (fun g (C : Clause L α) => RelSubsumes B C (τ g)) Q =
      Concept.ofAttribute _ u :=
  ofObjects_eq_ofAttribute_of_isLUB (τ := fun g => toRelSubsumption B (τ g))
    ((Set.image_image _ _ _).symm ▸ hu)

/-- Relative to background clauses `B`, some concept is consistent with `Q` and `N` if and only
if no negative statement is subsumed relative to `B` by a least general generalization `u` of the
clauses of `Q` relative to `B`. -/
theorem nonempty_consistentConcepts_relSubsumes_iff
    (hu : IsLUB (toRelSubsumption B '' (τ '' Q)) (toRelSubsumption B u)) :
    (consistentConcepts (fun g (C : Clause L α) => RelSubsumes B C (τ g)) Q N).Nonempty ↔
      ∀ g ∈ N, ¬RelSubsumes B u (τ g) :=
  nonempty_consistentConcepts_iff_of_isLUB (τ := fun g => toRelSubsumption B (τ g))
    ((Set.image_image _ _ _).symm ▸ hu)

/-- Relative to background clauses `B`, if no negative statement is subsumed relative to `B` by a
least general generalization `u` of the clauses of `Q` relative to `B`, the attribute concept of
`u` is the least answer. -/
theorem isLeast_ofAttribute_relSubsumes
    (hu : IsLUB (toRelSubsumption B '' (τ '' Q)) (toRelSubsumption B u))
    (hN : ∀ g ∈ N, ¬RelSubsumes B u (τ g)) :
    IsLeast (consistentConcepts (fun g (C : Clause L α) => RelSubsumes B C (τ g)) Q N)
      (Concept.ofAttribute _ u) :=
  isLeast_ofAttribute_of_isLUB (τ := fun g => toRelSubsumption B (τ g))
    ((Set.image_image _ _ _).symm ▸ hu) hN

-- The hypothesis `hN` is needed already for `B = ∅`, by the example of
-- `certainPredictions_subsumes_eq`.
/-- Relative to background clauses `B`, if no negative statement is subsumed relative to `B` by a
least general generalization `u` of the clauses of `Q` relative to `B`, the certain predictions
are the statements subsumed by `u` relative to `B`. -/
theorem certainPredictions_relSubsumes_eq
    (hu : IsLUB (toRelSubsumption B '' (τ '' Q)) (toRelSubsumption B u))
    (hN : ∀ g ∈ N, ¬RelSubsumes B u (τ g)) :
    certainPredictions (fun g (C : Clause L α) => RelSubsumes B C (τ g)) Q N =
      {g | RelSubsumes B u (τ g)} :=
  certainPredictions_eq_of_isLUB (τ := fun g => toRelSubsumption B (τ g))
    ((Set.image_image _ _ _).symm ▸ hu) hN

/-- The least answer relative to background clauses for two positive statements whose clauses
have finite saturations (Plotkin 1971): if `ν` names the disagreement pairs of the saturations
injectively, the concept generated by the two statements is the attribute concept of the
anti-unifier `Clause.lgg ν` of the saturations (`RelSubsumption.isLUB_lgg_saturation`). -/
theorem ofObjects_pair_relSubsumes_eq_ofAttribute_lgg {g₁ g₂ : G}
    (h₁ : (saturation B (τ g₁)).Finite) (h₂ : (saturation B (τ g₂)).Finite)
    {ν : L.Term α × L.Term α → α}
    (hν : Set.InjOn ν (Clause.antiUnify h₁.toFinset h₂.toFinset).varSet) :
    Concept.ofObjects (fun g (C : Clause L α) => RelSubsumes B C (τ g)) {g₁, g₂} =
      Concept.ofAttribute _ (Clause.lgg ν h₁.toFinset h₂.toFinset) :=
  ofObjects_relSubsumes_eq_ofAttribute
    (isLUB_image_image_pair (RelSubsumption.isLUB_lgg_saturation h₁ h₂ hν))

/-- For two positive statements whose clauses have finite saturations relative to `B`, with the
disagreement pairs of the saturations named injectively by `ν`, some concept is consistent with
them and the negative statements `N` if and only if no negative statement is subsumed relative to
`B` by the anti-unifier `Clause.lgg ν` of the saturations. -/
theorem nonempty_consistentConcepts_pair_relSubsumes_iff {g₁ g₂ : G}
    (h₁ : (saturation B (τ g₁)).Finite) (h₂ : (saturation B (τ g₂)).Finite)
    {ν : L.Term α × L.Term α → α}
    (hν : Set.InjOn ν (Clause.antiUnify h₁.toFinset h₂.toFinset).varSet) :
    (consistentConcepts (fun g (C : Clause L α) => RelSubsumes B C (τ g)) {g₁, g₂} N).Nonempty ↔
      ∀ g ∈ N, ¬RelSubsumes B (Clause.lgg ν h₁.toFinset h₂.toFinset) (τ g) :=
  nonempty_consistentConcepts_relSubsumes_iff
    (isLUB_image_image_pair (RelSubsumption.isLUB_lgg_saturation h₁ h₂ hν))

-- The hypotheses are those of `RelSubsumption.exists_isLUB_of_flat`, with the same comments on
-- their necessity: without a least general generalization the first conjunct fails. No
-- nonemptiness of `Q` is needed.
/-- Relative to a background with finite saturations (`isConsequence_or_finite_saturation`), such
as a finite typeclass hierarchy `Ring(x) ← Field(x)`, the clauses of every finite set `Q` of
statements have a least general generalization `u` relative to the background, provided `α` is
infinite or empty (`RelSubsumption.exists_isLUB_of_flat`), and the concept generated by `Q` is
the attribute concept of `u`. -/
theorem exists_ofObjects_relSubsumes_eq_ofAttribute_of_flat (hα : Finite α → IsEmpty α)
    (hB : B.Finite)
    (hflat : ∀ E ∈ B, ∀ l ∈ E, ∀ i,
      (∃ x, l.atom.args i = Term.var x) ∨ MathlibLattice.Term.varSet (l.atom.args i) = ∅)
    (hhead : ∀ E ∈ B, E.posVarSet ⊆ E.negVarSet) (hbody : ∀ E ∈ B, E.negVarSet ⊆ E.posVarSet)
    (hQ : Q.Finite) :
    ∃ u : Clause L α, IsLUB (toRelSubsumption B '' (τ '' Q)) (toRelSubsumption B u) ∧
      Concept.ofObjects (fun g (C : Clause L α) => RelSubsumes B C (τ g)) Q =
        Concept.ofAttribute _ u :=
  (RelSubsumption.exists_isLUB_of_flat hα hB hflat hhead hbody ((hQ.image _).image _)).imp
    fun _ hu => ⟨hu, ofObjects_relSubsumes_eq_ofAttribute hu⟩

open scoped Classical in
/-- Relative to `B`, disjoint clauses both subsume a clause exactly when their union does. -/
private lemma relSubsumes_union_iff {C D E : Clause L α} (h : Disjoint C.varSet D.varSet) :
    RelSubsumes B (C ∪ D) E ↔ RelSubsumes B C E ∧ RelSubsumes B D E := by
  refine ⟨fun hE => ⟨((Subsumes.of_subset Finset.subset_union_left).relSubsumes B).trans hE,
    ((Subsumes.of_subset Finset.subset_union_right).relSubsumes B).trans hE⟩,
    fun ⟨⟨θ₁, h₁⟩, ⟨θ₂, h₂⟩⟩ => ⟨fun x => if x ∈ C.varSet then θ₁ x else θ₂ x,
      fun M _ _ hM v ⟨l, hl, hr⟩ => ?_⟩⟩
  rw [← Literal.realize_subst] at hr
  rcases Finset.mem_union.1 hl with hl | hl
  · rw [literal_subst_congr (σ' := θ₁) fun x hx =>
      if_pos (show x ∈ C.varSet from Set.mem_iUnion₂.2 ⟨l, hl, hx⟩)] at hr
    exact h₁ M hM v ⟨l, hl, (Literal.realize_subst l θ₁).1 hr⟩
  · rw [literal_subst_congr (σ' := θ₂) fun x hx =>
      if_neg (Set.disjoint_right.1 h (show x ∈ D.varSet from Set.mem_iUnion₂.2 ⟨l, hl, hx⟩))] at hr
    exact h₂ M hM v ⟨l, hl, (Literal.realize_subst l θ₂).1 hr⟩

open scoped Classical in
-- `h` is needed already for `B = ∅`, by the example of `ofAttribute_inf_ofAttribute_subsumes`,
-- whose statement is no consequence of `∅`.
/-- Relative to background clauses `B`, the meet of the concepts of two clauses with disjoint
variables is the concept of their union. -/
theorem ofAttribute_inf_ofAttribute_relSubsumes {C D : Clause L α}
    (h : Disjoint C.varSet D.varSet) :
    Concept.ofAttribute (fun g (E : Clause L α) => RelSubsumes B E (τ g)) C ⊓
        Concept.ofAttribute _ D = Concept.ofAttribute _ (C ∪ D) := by
  ext g
  simp [relSubsumes_union_iff, h]

-- The hypotheses are needed already for `B = ∅`, by the examples of
-- `exists_eq_ofAttribute_subsumes`, whose statements are no consequences of `∅`.
/-- Relative to any background clauses `B`, every concept of the context of a finite corpus of
clauses is the attribute concept of a clause, provided `α` is infinite or empty: the union of
finitely many clauses of its intent with their variables renamed apart
(`ofAttribute_inf_ofAttribute_relSubsumes`). No finite saturation is needed. -/
theorem exists_eq_ofAttribute_relSubsumes [Finite G] (hα : Finite α → IsEmpty α)
    (c : Concept G (Clause L α) fun g C => RelSubsumes B C (τ g)) :
    ∃ C : Clause L α, c = Concept.ofAttribute _ C :=
  exists_eq_ofAttribute_of_finite hα (fun X => (Subsumes.of_subset X.empty_subset).relSubsumes B)
    (fun h hX => (h.relSubsumes B).trans hX) (fun h _ => relSubsumes_union_iff h) c

-- The hypotheses are needed already for `B = ∅`, by the examples of
-- `consistentConcepts_subsumes_eq_image`.
/-- Relative to any background clauses `B`, the answers to the query over a finite corpus of
clauses are described by clauses when `α` is infinite or empty: the consistent concepts are the
attribute concepts of the clauses subsuming, relative to `B`, every positive statement and no
negative statement. -/
theorem consistentConcepts_relSubsumes_eq_image [Finite G] (hα : Finite α → IsEmpty α) :
    consistentConcepts (fun g (C : Clause L α) => RelSubsumes B C (τ g)) Q N =
      Concept.ofAttribute _ ''
        {C | (∀ g ∈ Q, RelSubsumes B C (τ g)) ∧ ∀ g ∈ N, ¬RelSubsumes B C (τ g)} :=
  consistentConcepts_eq_image_ofAttribute_iff.2 fun c _ =>
    (exists_eq_ofAttribute_relSubsumes hα c).imp fun _ => Eq.symm

-- The hypotheses are needed already for `B = ∅`, by the examples of
-- `maximalConsistentConcepts_subsumes_eq`.
/-- Relative to any background clauses `B`, the most general answers to the query over a finite
corpus of clauses, when `α` is infinite or empty, are the maximal attribute concepts of the
clauses subsuming, relative to `B`, every positive statement and no negative statement. -/
theorem maximalConsistentConcepts_relSubsumes_eq [Finite G] (hα : Finite α → IsEmpty α) :
    maximalConsistentConcepts (fun g (C : Clause L α) => RelSubsumes B C (τ g)) Q N =
      {c | Maximal (· ∈ Concept.ofAttribute _ ''
        {C | (∀ g ∈ Q, RelSubsumes B C (τ g)) ∧ ∀ g ∈ N, ¬RelSubsumes B C (τ g)}) c} :=
  maximalConsistentConcepts_eq_of_subset_range_ofAttribute fun c _ =>
    (exists_eq_ofAttribute_relSubsumes hα c).imp fun _ => Eq.symm

end Relative

/-! ### Soundness -/

/-- Soundness of the query: in a context `r` relating statements to descriptions, let a notion of
truth `T` of descriptions be sound for it, so that if `r g C` and `C` is true, the statement `g` is
true (`T' g`). If a true description `C` is shared by every positive statement and every negative
statement is false, the attribute concept of `C` is an answer (`disjoint_extent_of_sound`). -/
theorem ofAttribute_mem_consistentConcepts_of_sound {X : Type*} {r : G → X → Prop}
    {T : X → Prop} {T' : G → Prop} (hr : ∀ g C, r g C → T C → T' g) {C : X}
    (hQ : ∀ g ∈ Q, r g C) (hC : T C) (hN : ∀ g ∈ N, ¬T' g) :
    Concept.ofAttribute r C ∈ consistentConcepts r Q N :=
  ⟨fun g hg _ hb => hb ▸ hQ g hg, disjoint_extent_of_sound hr hN (fun _ ha => ha rfl) hC⟩

/-- A true common generalization of the positive statements gives an answer: if a clause `C`
subsumes every positive statement and holds in a structure `M` in which every negative statement
is refuted, the attribute concept of `C` is consistent with `Q` and `N`. This applies to a least
general generalization of the clauses of `Q`. -/
theorem ofAttribute_mem_consistentConcepts_of_holds {M : Type*} [L.Structure M] {C : Clause L α}
    (hQ : ∀ g ∈ Q, Subsumes C (τ g)) (hC : C.Holds M) (hN : ∀ g ∈ N, ¬(τ g).Holds M) :
    Concept.ofAttribute (fun g (D : Clause L α) => Subsumes D (τ g)) C ∈
      consistentConcepts (fun g (D : Clause L α) => Subsumes D (τ g)) Q N :=
  ofAttribute_mem_consistentConcepts_of_sound (fun _ _ h hD => h.holds hD) hQ hC hN

/-- Answers exist when a common generalization of the positive statements holds in a structure in
which every negative statement is refuted. -/
theorem nonempty_consistentConcepts_of_holds {M : Type*} [L.Structure M] {C : Clause L α}
    (hQ : ∀ g ∈ Q, Subsumes C (τ g)) (hC : C.Holds M) (hN : ∀ g ∈ N, ¬(τ g).Holds M) :
    (consistentConcepts (fun g (D : Clause L α) => Subsumes D (τ g)) Q N).Nonempty :=
  ⟨_, ofAttribute_mem_consistentConcepts_of_holds hQ hC hN⟩

/-- Relative to background clauses `B`, a true common generalization of the positive statements
gives an answer: if a clause `C` subsumes every positive statement relative to `B` and holds in a
model `M` of `B` in which every negative statement is refuted, the attribute concept of `C` is
consistent with `Q` and `N`. -/
theorem ofAttribute_mem_consistentConcepts_of_holds_relSubsumes {β : Type*}
    {B : Set (Clause L β)} {M : Type (max u₁ u₂ u₃)} [L.Structure M] [Nonempty M]
    (hB : ∀ E ∈ B, E.Holds M) {C : Clause L α} (hQ : ∀ g ∈ Q, RelSubsumes B C (τ g))
    (hC : C.Holds M) (hN : ∀ g ∈ N, ¬(τ g).Holds M) :
    Concept.ofAttribute (fun g (D : Clause L α) => RelSubsumes B D (τ g)) C ∈
      consistentConcepts (fun g (D : Clause L α) => RelSubsumes B D (τ g)) Q N :=
  ofAttribute_mem_consistentConcepts_of_sound (fun _ _ h hD => h.holds hB hD) hQ hC hN

/-- Relative to background clauses `B`, answers exist when a common generalization of the
positive statements holds in a model of `B` in which every negative statement is refuted. -/
theorem nonempty_consistentConcepts_of_holds_relSubsumes {β : Type*} {B : Set (Clause L β)}
    {M : Type (max u₁ u₂ u₃)} [L.Structure M] [Nonempty M] (hB : ∀ E ∈ B, E.Holds M)
    {C : Clause L α} (hQ : ∀ g ∈ Q, RelSubsumes B C (τ g)) (hC : C.Holds M)
    (hN : ∀ g ∈ N, ¬(τ g).Holds M) :
    (consistentConcepts (fun g (D : Clause L α) => RelSubsumes B D (τ g)) Q N).Nonempty :=
  ⟨_, ofAttribute_mem_consistentConcepts_of_holds_relSubsumes hB hQ hC hN⟩

end MathlibLattice.Query
