import MathlibLattice.Query.Corpus
import MathlibLattice.Term.PatternStructure

-- The library's files carry no copyright header.
set_option linter.style.header false

/-!
# The generalization query over a corpus of terms

A corpus of first-order terms `τ : G → L.Term α`, for instance the statements of a library, gives
the instantiation context `(G, L.Term α, fun g t => IsInstance (τ g) t)`: the statement `g` has
the description `t` when its term is an instance of `t`. The query asks what the positive
statements `Q` generalize to while excluding the negative statements `N`, and anti-unification
answers it. This is the case `P = Generality L α` of the query over a corpus in a preorder.

If `u` is a least general generalization of the terms of `Q` (Plotkin 1970, Reynolds 1970), which
exists when `Q` is nonempty and `α` is infinite or has one or two elements, the concept generated
by `Q` is the attribute concept of `u`: its intent is the set of generalizations of `u`, and its
extent is the set of statements whose terms are instances of `u`. No nonemptiness of `Q` is
needed for this. Hence answers exist if and only if no negative statement is an instance of `u`,
the least answer is then the concept of `u`, and the certain predictions are the statements of
the corpus that are instances of `u`. For nonempty `Q`, when `α` is infinite or has one or two
elements, every answer is the attribute concept of a pattern `t` such that every positive
statement is an instance of `t` and no negative statement is, and the most general answers are the
maximal ones among these concepts. A concept is unstated exactly when the least general
generalization of the terms of its extent is a variant of no statement of the corpus.

For a finite corpus the renaming classes of the generalizations of its terms are finitely many,
and restricting the descriptions to them changes no nonempty extent, so the results on finite
contexts apply; for nonempty `Q` the answers and the most general answers have the same extents
in both contexts. Every term has finitely many generalizations up to renaming, so every set of
classes separating a nonempty `Q` from `N` is finite. Hence for every corpus, finite or not, the
most general answers come from the minimal sets of classes of generalizations separating `Q` from
`N`, and there are at most as many of them as such sets. The pattern structure of the corpus gives
the same answers: its pattern concept generated by a nonempty `Q` has the description of the least
general generalization of `Q` as intent and the instances of it as extent.

## Main statements

* `intent_ofObjects_isInstance`, `extent_ofObjects_isInstance`,
  `ofObjects_isInstance_eq_ofAttribute`, `exists_isLUB_extent_ofObjects_isInstance`: the concept
  generated by `Q` is the concept of the least general generalization of its terms.
* `nonempty_consistentConcepts_isInstance_iff`, `isLeast_ofAttribute_isInstance`,
  `certainPredictions_isInstance_eq`: existence of answers, the least answer and the certain
  predictions.
* `consistentConcepts_isInstance_eq_image`, `maximalConsistentConcepts_isInstance_eq`: the
  answers and the most general answers are described by patterns.
* `isUnstated_isInstance_iff`: unstated concepts and variants.
* `finite_generalizations_isInstance`, `isExtent_generalizationContext_iff_isInstance`: finitely
  many descriptions suffice for a finite corpus.
* `image_extent_consistentConcepts_generalizationContext_isInstance`,
  `image_extent_maximalConsistentConcepts_generalizationContext_isInstance`: for nonempty `Q` the
  answers and the most general answers are the same on the classes of generalizations.
* `image_extent_maximalConsistentConcepts_isInstance_eq`,
  `card_maximalConsistentConcepts_isInstance_le`: the most general answers come from the minimal
  separating sets of classes of generalizations, which bound their number.
* `intent_ofObjects_termPattern`, `extent_ofObjects_termPattern`,
  `nonempty_versionSpace_termPattern_iff`, `isLeast_ofObjects_versionSpace_termPattern`,
  `image_versionSpace_orderIsoConceptIsInstance`: the same answers in the pattern structure of
  the corpus.

## References

* G. D. Plotkin, *A note on inductive generalization*, 1970.
* J. C. Reynolds, *Transformational systems and the algebraic structure of atomic formulas*,
  1970.
* T. M. Mitchell, *Generalization as search*, Artificial Intelligence 18, 1982.
* B. Ganter and S. O. Kuznetsov, *Pattern structures and their projections*, 2001.
-/

namespace MathlibLattice.Query

open PatternStructure MathlibLattice.Term

variable {L : FirstOrder.Language} {α G : Type*} {τ : G → L.Term α} {Q N : Set G}
  {u : L.Term α}

/-! ### The concept generated by the positive statements -/

/-- In the instantiation context of a corpus of terms, the descriptions common to the statements
of `Q` are the generalizations of a least general generalization `u` of their terms. No
nonemptiness of `Q` is needed. -/
theorem intent_ofObjects_isInstance (hu : IsLUB (toGenerality '' (τ '' Q)) (toGenerality u)) :
    (Concept.ofObjects (fun g (t : L.Term α) => IsInstance (τ g) t) Q).intent =
      {t | IsInstance u t} :=
  intent_ofObjects_of_isLUB (Set.image_image _ _ _ ▸ hu)

/-- In the instantiation context of a corpus of terms, the extent of the concept generated by `Q`
is the set of statements whose terms are instances of a least general generalization `u` of the
terms of `Q`. No nonemptiness of `Q` is needed. -/
theorem extent_ofObjects_isInstance (hu : IsLUB (toGenerality '' (τ '' Q)) (toGenerality u)) :
    (Concept.ofObjects (fun g (t : L.Term α) => IsInstance (τ g) t) Q).extent =
      {g | IsInstance (τ g) u} :=
  extent_ofObjects_of_isLUB (Set.image_image _ _ _ ▸ hu)

/-- In the instantiation context of a corpus of terms, the concept generated by `Q` is the
attribute concept of a least general generalization `u` of the terms of `Q`. -/
theorem ofObjects_isInstance_eq_ofAttribute
    (hu : IsLUB (toGenerality '' (τ '' Q)) (toGenerality u)) :
    Concept.ofObjects (fun g (t : L.Term α) => IsInstance (τ g) t) Q =
      Concept.ofAttribute _ u :=
  ofObjects_eq_ofAttribute_of_isLUB (Set.image_image _ _ _ ▸ hu)

-- `hα` and `hQ` are needed, as for `MathlibLattice.Term.exists_isLUB`: over three variables two
-- terms can have two incomparable minimal common generalizations, and over no variables two
-- distinct ground terms have no common generalization.
/-- If `α` is infinite or has one or two elements, the terms of a nonempty set `Q` of statements
have a least general generalization `u` (Plotkin 1970, Reynolds 1970), and the extent of the
concept generated by `Q` is the set of statements whose terms are instances of `u`. -/
theorem exists_isLUB_extent_ofObjects_isInstance
    (hα : Finite α → Nat.card α = 1 ∨ Nat.card α = 2) (hQ : Q.Nonempty) :
    ∃ u : L.Term α, IsLUB (toGenerality '' (τ '' Q)) (toGenerality u) ∧
      (Concept.ofObjects (fun g (t : L.Term α) => IsInstance (τ g) t) Q).extent =
        {g | IsInstance (τ g) u} :=
  (Term.exists_isLUB hα ((hQ.image τ).image toGenerality)).imp' ofGenerality fun _ hx =>
    ⟨hx, extent_ofObjects_isInstance hx⟩

/-! ### Answers -/

/-- In the instantiation context of a corpus of terms, some concept is consistent with the
positive statements `Q` and the negative statements `N` if and only if no negative statement is
an instance of a least general generalization `u` of the terms of `Q`. -/
theorem nonempty_consistentConcepts_isInstance_iff
    (hu : IsLUB (toGenerality '' (τ '' Q)) (toGenerality u)) :
    (consistentConcepts (fun g (t : L.Term α) => IsInstance (τ g) t) Q N).Nonempty ↔
      ∀ g ∈ N, ¬IsInstance (τ g) u :=
  nonempty_consistentConcepts_iff_of_isLUB (Set.image_image _ _ _ ▸ hu)

/-- In the instantiation context of a corpus of terms, if no negative statement is an instance of
a least general generalization `u` of the terms of `Q`, the attribute concept of `u` is the least
consistent concept: the least general answer is the concept of the pattern `u`. -/
theorem isLeast_ofAttribute_isInstance (hu : IsLUB (toGenerality '' (τ '' Q)) (toGenerality u))
    (hN : ∀ g ∈ N, ¬IsInstance (τ g) u) :
    IsLeast (consistentConcepts (fun g (t : L.Term α) => IsInstance (τ g) t) Q N)
      (Concept.ofAttribute _ u) :=
  isLeast_ofAttribute_of_isLUB (Set.image_image _ _ _ ▸ hu) hN

-- The hypothesis `hN` is needed: for the corpus of two distinct constants `c` and `d`, `u = c`
-- and `Q = N` the first statement, no concept is consistent, so both statements are certain
-- predictions, while only the first is an instance of `c`.
/-- In the instantiation context of a corpus of terms, if no negative statement is an instance of
a least general generalization `u` of the terms of `Q`, the certain predictions are the
statements of the corpus that are instances of `u`. -/
theorem certainPredictions_isInstance_eq
    (hu : IsLUB (toGenerality '' (τ '' Q)) (toGenerality u)) (hN : ∀ g ∈ N, ¬IsInstance (τ g) u) :
    certainPredictions (fun g (t : L.Term α) => IsInstance (τ g) t) Q N =
      {g | IsInstance (τ g) u} :=
  certainPredictions_eq_of_isLUB (Set.image_image _ _ _ ▸ hu) hN

-- The exact condition for the conclusion is that every consistent concept is an attribute concept
-- (`consistentConcepts_eq_image_ofAttribute_iff`); `hα` and `hQ` together are a sufficient
-- condition, and neither can be dropped. `hα` cannot be dropped: over three variables the terms
-- `p(f(a, a), f(a, a))` and `p(f(b, c), f(d, e))` have the incomparable minimal common
-- generalizations `p(f(x, y), z)` and `p(z, f(x, y))`; with these two statements positive and
-- `p(f(a, b), a)`, `p(a, f(a, b))` negative, the concept generated by the positive statements is
-- consistent and is no attribute concept. `hQ` cannot be dropped: for the
-- corpus of the two constants of the language with two constants and no other symbols, `Q = ∅`
-- and `N` both statements, the concept with empty extent is consistent, while every term has one
-- of the two constants as an instance.
/-- If `α` is infinite or has one or two elements and `Q` is nonempty, the answers to the query
are described by patterns: the consistent concepts are the attribute concepts of the terms `t`
such that every positive statement is an instance of `t` and no negative statement is. This is
`consistentConcepts_eq_image_ofAttribute_iff`: every consistent concept has a nonempty extent,
whose terms have a least general generalization `u` (`MathlibLattice.Term.exists_isLUB`), so it is
the attribute concept of `u` (`ofObjects_isInstance_eq_ofAttribute` for its extent). -/
theorem consistentConcepts_isInstance_eq_image
    (hα : Finite α → Nat.card α = 1 ∨ Nat.card α = 2) (hQ : Q.Nonempty) :
    consistentConcepts (fun g (t : L.Term α) => IsInstance (τ g) t) Q N =
      Concept.ofAttribute _ ''
        {t | (∀ g ∈ Q, IsInstance (τ g) t) ∧ ∀ g ∈ N, ¬IsInstance (τ g) t} :=
  (consistentConcepts_eq_image_ofAttribute_of_isLUB (τ := fun g => toGenerality (τ g)) fun _ hc =>
    Term.exists_isLUB hα ((hQ.mono hc.1).image _)).trans
      (congrArg _ (Set.ext fun _ => and_congr_left' Set.forall_mem_image))

-- `hα` and `hQ` together are a sufficient condition, and neither can be dropped, by the examples
-- before `consistentConcepts_isInstance_eq_image`: there the left side is nonempty and the right
-- side is empty.
/-- If `α` is infinite or has one or two elements and `Q` is nonempty, the most general answers
are the maximal attribute concepts of the terms `t` such that every positive statement is an
instance of `t` and no negative statement is. This is
`maximalConsistentConcepts_eq_of_subset_range_ofAttribute`, since every consistent concept is
then an attribute concept, as in `consistentConcepts_isInstance_eq_image`. -/
theorem maximalConsistentConcepts_isInstance_eq
    (hα : Finite α → Nat.card α = 1 ∨ Nat.card α = 2) (hQ : Q.Nonempty) :
    maximalConsistentConcepts (fun g (t : L.Term α) => IsInstance (τ g) t) Q N =
      {c | Maximal (· ∈ Concept.ofAttribute _ ''
        {t | (∀ g ∈ Q, IsInstance (τ g) t) ∧ ∀ g ∈ N, ¬IsInstance (τ g) t}) c} :=
  congrArg (fun s => {c | Maximal (· ∈ s) c}) (consistentConcepts_isInstance_eq_image hα hQ)

/-! ### Unstated concepts -/

/-- In the instantiation context of a corpus of terms, a concept whose extent has terms with a
least general generalization `u` is unstated if and only if `u` is a variant of no statement of
the corpus. -/
theorem isUnstated_isInstance_iff {c : Concept G (L.Term α) fun g t => IsInstance (τ g) t}
    (hu : IsLUB (toGenerality '' (τ '' c.extent)) (toGenerality u)) :
    IsUnstated _ c ↔ ∀ g, ¬IsVariant u (τ g) :=
  (isUnstated_iff_of_isLUB (Set.image_image _ _ _ ▸ hu)).trans
    (forall_congr' fun _ => not_congr antisymmRel_iff_isVariant)

/-! ### Finitely many descriptions -/

/-- A finite corpus of terms has finitely many renaming classes of generalizations of its terms
(`MathlibLattice.Term.finite_Ici`), so its generalization context has finitely many attributes
and finitely many concepts. -/
theorem finite_generalizations_isInstance [Finite G] (τ : G → L.Term α) :
    Finite {x : Antisymmetrization (Generality L α) (· ≤ ·) //
      ∃ g, toAntisymmetrization (· ≤ ·) (toGenerality (τ g)) ≤ x} :=
  finite_generalizations fun _ => finite_Ici _

-- Nonemptiness is needed: for the corpus of the one term `f(x)` in a language with a constant and
-- a unary function symbol `f`, the empty set is an extent of the instantiation context, since
-- `f(x)` is not an instance of the constant, but not of the generalization context, whose
-- attributes are the classes of `f(x)` and of a variable.
/-- Restricting the descriptions of a corpus of terms to the renaming classes of the
generalizations of its terms changes no nonempty extent of the instantiation context. -/
theorem isExtent_generalizationContext_iff_isInstance {A : Set G} (hA : A.Nonempty) :
    Order.IsExtent (generalizationContext fun g => toGenerality (τ g)) A ↔
      Order.IsExtent (fun g (t : L.Term α) => IsInstance (τ g) t) A :=
  isExtent_generalizationContext_iff hA

-- Nonemptiness is needed here and in the next three theorems: in the example before
-- `isExtent_generalizationContext_iff_isInstance`, for `Q = ∅` and `N` the one statement, the
-- concept of the instantiation context with empty extent is the only consistent concept, while no
-- concept of the generalization context is consistent and no set of classes of generalizations
-- separates `Q` from `N`.
/-- For a nonempty set `Q` of positive statements, the extents of the answers are the same in the
generalization context, on the renaming classes of the generalizations of the terms of the corpus,
and in the instantiation context. This is `image_extent_consistentConcepts_generalizationContext`
for terms ordered by generality. -/
theorem image_extent_consistentConcepts_generalizationContext_isInstance (hQ : Q.Nonempty) :
    Concept.extent '' consistentConcepts (generalizationContext fun g => toGenerality (τ g)) Q N =
      Concept.extent '' consistentConcepts (fun g (t : L.Term α) => IsInstance (τ g) t) Q N :=
  image_extent_consistentConcepts_generalizationContext hQ

/-- For a nonempty set `Q` of positive statements, the extents of the most general answers are the
same in the generalization context and in the instantiation context. This is
`image_extent_maximalConsistentConcepts_generalizationContext` for terms ordered by
generality. -/
theorem image_extent_maximalConsistentConcepts_generalizationContext_isInstance
    (hQ : Q.Nonempty) :
    Concept.extent ''
        maximalConsistentConcepts (generalizationContext fun g => toGenerality (τ g)) Q N =
      Concept.extent ''
        maximalConsistentConcepts (fun g (t : L.Term α) => IsInstance (τ g) t) Q N :=
  image_extent_maximalConsistentConcepts_generalizationContext hQ

/-- For nonempty `Q`, finitely many sets of classes of generalizations separate `Q` from `N`. -/
private lemma finite_separatingSets_generalizationContext (hQ : Q.Nonempty) :
    (separatingSets (generalizationContext fun g => toGenerality (τ g)) Q N).Finite :=
  hQ.elim fun q hq => ((finite_Ici (toAntisymmetrization (· ≤ ·) (toGenerality (τ q)))).preimage
    Subtype.val_injective.injOn).finite_subsets.subset fun _ hT _ hx => hT.1 hx hq

/-- The general boundary of a corpus of terms (Mitchell 1982): for a nonempty set `Q` of positive
statements, the most general answers have the extents of the maximal concepts of the
generalization context generated by the minimal sets of classes of generalizations separating `Q`
from `N`. No finiteness of the corpus is needed: a separating set consists of generalizations of
the term of one positive statement, which are finitely many up to renaming
(`MathlibLattice.Term.finite_Ici`), so it contains a minimal one, and
`maximalConsistentConcepts_eq_of_forall_exists_minimal` applies to the generalization context;
`image_extent_maximalConsistentConcepts_generalizationContext_isInstance` transfers it. -/
theorem image_extent_maximalConsistentConcepts_isInstance_eq (hQ : Q.Nonempty) :
    Concept.extent '' maximalConsistentConcepts (fun g (t : L.Term α) => IsInstance (τ g) t) Q N =
      Concept.extent '' {c | Maximal (· ∈ Concept.ofAttributes
        (generalizationContext fun g => toGenerality (τ g)) ''
          {T | Minimal (· ∈ separatingSets (generalizationContext fun g => toGenerality (τ g)) Q N)
            T}) c} :=
  (image_extent_maximalConsistentConcepts_generalizationContext_isInstance hQ).symm.trans
    (congrArg _ (maximalConsistentConcepts_eq_of_forall_exists_minimal fun _ hT =>
      (finite_separatingSets_generalizationContext hQ).exists_le_minimal hT))

/-- For a nonempty set `Q` of positive statements, there are at most as many most general answers
as minimal sets of classes of generalizations separating `Q` from `N`, and these sets are finitely
many, since they consist of generalizations of the term of one positive statement
(`MathlibLattice.Term.finite_Ici`). This is `encard_maximalConsistentConcepts_le` for the
generalization context, transferred by
`image_extent_maximalConsistentConcepts_generalizationContext_isInstance`. No finiteness of the
corpus is needed. -/
theorem card_maximalConsistentConcepts_isInstance_le (hQ : Q.Nonempty) :
    Nat.card (maximalConsistentConcepts (fun g (t : L.Term α) => IsInstance (τ g) t) Q N) ≤
      Nat.card {T | Minimal
        (· ∈ separatingSets (generalizationContext fun g => toGenerality (τ g)) Q N) T} := by
  rw [← Nat.card_image_of_injective Concept.extent_injective,
    image_extent_maximalConsistentConcepts_isInstance_eq hQ,
    Nat.card_image_of_injective Concept.extent_injective, Nat.card_coe_set_eq, Nat.card_coe_set_eq]
  exact (Set.ncard_le_ncard (fun _ hc => hc.prop)
    (((finite_separatingSets_generalizationContext hQ).subset fun _ hT => hT.prop).image _)).trans
      (Set.ncard_image_le ((finite_separatingSets_generalizationContext hQ).subset
        fun _ hT => hT.prop))

/-! ### The pattern structure of the corpus -/

section PatternStructure

variable [Fact (Finite α → Nat.card α = 1 ∨ Nat.card α = 2)]

-- `hQ` is needed: the pattern concept generated by `∅` has the inconsistent description as
-- intent, which is the description of no term, while in the language without symbols every term
-- is a least general generalization of `∅`.
/-- In the pattern structure of a corpus of terms, the pattern concept generated by a nonempty
set `Q` of statements has as intent the description of a least general generalization `u` of
their terms. -/
theorem intent_ofObjects_termPattern (hQ : Q.Nonempty)
    (hu : IsLUB (toGenerality '' (τ '' Q)) (toGenerality u)) :
    (PatternConcept.ofObjects (termPattern τ) Q).intent = toTermDescr u :=
  descr_termPattern τ hQ hu

-- `hQ` is needed: in the language without symbols every term is a least general generalization of
-- `∅` and every statement is an instance of it, while the pattern concept generated by `∅` has
-- empty extent.
/-- In the pattern structure of a corpus of terms, the pattern concept generated by a nonempty
set `Q` of statements has as extent the statements whose terms are instances of a least general
generalization `u` of the terms of `Q`. -/
theorem extent_ofObjects_termPattern (hQ : Q.Nonempty)
    (hu : IsLUB (toGenerality '' (τ '' Q)) (toGenerality u)) :
    (PatternConcept.ofObjects (termPattern τ) Q).extent = {g | IsInstance (τ g) u} :=
  (congrArg (extentOf (termPattern τ)) (descr_termPattern τ hQ hu)).trans
    (extentOf_toTermDescr τ u)

-- `hQ` is needed: for `Q = ∅` the pattern concept with empty extent is consistent, while in the
-- language without symbols every statement is an instance of every least general generalization
-- of `∅`.
/-- In the pattern structure of a corpus of terms, some pattern concept is consistent with a
nonempty set `Q` of positive statements and the negative statements `N` if and only if no
negative statement is an instance of a least general generalization `u` of the terms of `Q`. -/
theorem nonempty_versionSpace_termPattern_iff (hQ : Q.Nonempty)
    (hu : IsLUB (toGenerality '' (τ '' Q)) (toGenerality u)) :
    (VersionSpace.versionSpace (PatternConcept.extent : PatternConcept (termPattern τ) → Set G)
      Q N).Nonempty ↔ ∀ g ∈ N, ¬IsInstance (τ g) u :=
  (VersionSpace.nonempty_versionSpace_iff_of_galoisConnection fun _ _ =>
    PatternConcept.ofObjects_le_iff).trans (extent_ofObjects_termPattern hQ hu ▸ Set.disjoint_right)

/-- The pattern concept generated by `Q` lies among the instances of an upper bound of `Q`. -/
private lemma extent_ofObjects_termPattern_subset
    (hu : toGenerality u ∈ upperBounds (toGenerality '' (τ '' Q))) :
    (PatternConcept.ofObjects (termPattern τ) Q).extent ⊆ {g | IsInstance (τ g) u} :=
  fun _ hg => toTermDescr_le_termPattern.1 (((subset_extentOf_iff_le_descr (δ := termPattern τ)).1
    fun _ hq => toTermDescr_le_termPattern.2
      (hu (Set.mem_image_of_mem _ (Set.mem_image_of_mem _ hq)))).trans hg)

/-- In the pattern structure of a corpus of terms, if no negative statement is an instance of a
least general generalization `u` of the terms of `Q`, the pattern concept generated by `Q` is the
least consistent pattern concept. No nonemptiness of `Q` is needed: the pattern concept generated
by `∅` has empty extent. -/
theorem isLeast_ofObjects_versionSpace_termPattern
    (hu : IsLUB (toGenerality '' (τ '' Q)) (toGenerality u)) (hN : ∀ g ∈ N, ¬IsInstance (τ g) u) :
    IsLeast (VersionSpace.versionSpace
        (PatternConcept.extent : PatternConcept (termPattern τ) → Set G) Q N)
      (PatternConcept.ofObjects (termPattern τ) Q) :=
  ⟨⟨PatternConcept.ofObjects_le_iff.1 le_rfl, Set.disjoint_right.2 fun g hg hgQ =>
      hN g hg (extent_ofObjects_termPattern_subset hu.1 hgQ)⟩,
    fun _ hc => PatternConcept.ofObjects_le_iff.2 hc.1⟩

/-- If no statement of the corpus is an instance of every term, the isomorphism
`MathlibLattice.Term.orderIsoConceptIsInstance` from the pattern concepts of the corpus onto the
concepts of its instantiation context sends the consistent pattern concepts onto the consistent
concepts. -/
theorem image_versionSpace_orderIsoConceptIsInstance
    (h : ∀ g, ∃ t : L.Term α, ¬IsInstance (τ g) t) :
    orderIsoConceptIsInstance τ h '' VersionSpace.versionSpace PatternConcept.extent Q N =
      consistentConcepts (fun g (t : L.Term α) => IsInstance (τ g) t) Q N :=
  Set.ext fun c => ⟨fun ⟨p, hp, hpc⟩ => hpc ▸ (hp : orderIsoConceptIsInstance τ h p ∈ _),
    fun hc => ⟨_, hc, (orderIsoConceptIsInstance τ h).apply_symm_apply c⟩⟩

end PatternStructure

end MathlibLattice.Query
