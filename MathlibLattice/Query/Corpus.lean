import MathlibLattice.Query.Basic

-- The library's files carry no copyright header.
set_option linter.style.header false

/-!
# The query over a corpus in a preorder

A corpus `τ : G → P` describes each object `g` by an element `τ g` of a preordered type `P`, for
instance a first-order term or a higher-order pattern under instantiation, where `s ≤ t` when `s`
is an instance of `t`. The context of the corpus gives the object `g` the description `p` when
`τ g ≤ p`, that is, when `p` generalizes the term of `g`. In this context the generalization query
is answered by least upper bounds.

If `u` is a least upper bound of the terms of the positive objects `Q`, their least general
generalization, the concept generated by `Q` is the attribute concept of `u`: its intent is the
set of descriptions above `u` and its extent is the set of objects whose terms lie below `u`. No
nonemptiness of `Q` is needed. Hence answers exist if and only if no negative object has its term
below `u`, the least answer is then the concept of `u`, and the certain predictions are the
objects whose terms lie below `u`. A concept is the attribute concept of a description `u` exactly
when `u` is an upper bound of the terms of its extent and every object whose term lies below `u`
is in its extent; a least upper bound of these terms is one such description. The answers are the
attribute concepts of the descriptions above the term of every positive object and above the term
of no negative object exactly when every answer is an attribute concept, in particular when the
extent of every answer has terms with a least upper bound, and the most general answers are then
the maximal ones among them. A concept whose extent has terms with a least upper bound is
unstated exactly when this bound is equivalent to the term of no object.

The descriptions that matter are the generalizations of the terms of the corpus: on their classes
up to equivalence the context has the same nonempty extents, so for nonempty `Q` it has the same
answers and the same most general answers, up to identifying concepts with their extents. For a
finite corpus in which every term has finitely many generalizations up to equivalence, as for
first-order terms, these classes are finitely many, so the results on finite contexts apply.

## Main definitions

* `MathlibLattice.Query.generalizationContext τ`: the context of a corpus on the classes of the
  generalizations of its terms.

## Main statements

* `upperPolar_eq_upperBounds_image`: the descriptions common to a set of objects are the upper
  bounds of their terms.
* `ofObjects_eq_ofAttribute_iff_mem_upperBounds`, `eq_ofAttribute_iff_mem_upperBounds`: exactly
  when the concept generated by `Q`, or any concept, is the attribute concept of a description.
* `intent_ofObjects_of_isLUB`, `extent_ofObjects_of_isLUB`, `ofObjects_eq_ofAttribute_of_isLUB`:
  the concept generated by `Q` is the attribute concept of the least upper bound of its terms.
* `nonempty_consistentConcepts_iff_of_isLUB`, `isLeast_ofAttribute_of_isLUB`,
  `certainPredictions_eq_of_isLUB`: existence of answers, the least answer and the certain
  predictions.
* `consistentConcepts_eq_image_ofAttribute_upperBounds_iff`,
  `maximalConsistentConcepts_eq_upperBounds_of_subset_range`: the answers and the most general
  answers are attribute concepts exactly when every answer is one.
* `eq_ofAttribute_of_isLUB`, `consistentConcepts_eq_image_ofAttribute_of_isLUB`,
  `maximalConsistentConcepts_eq_of_isLUB`: least upper bounds make the answers and the most
  general answers attribute concepts.
* `ofObjects_eq_ofAttribute_descr`, `nonempty_consistentConcepts_iff_descr`,
  `certainPredictions_eq_extentOf_descr`: the same for the representation context of a pattern
  structure, where least upper bounds always exist, in particular at every level of the height
  filtration.
* `isUnstated_iff_of_isLUB`: unstated concepts.
* `isExtent_generalizationContext_iff`, `finite_generalizations`: the generalizations of the terms
  of the corpus suffice, and are finitely many for a finite corpus.
* `image_extent_consistentConcepts_generalizationContext`,
  `image_extent_maximalConsistentConcepts_generalizationContext`: for nonempty `Q` the answers and
  the most general answers have the same extents on the generalizations of the terms.

## References

* G. D. Plotkin, *A note on inductive generalization*, 1970.
* T. M. Mitchell, *Generalization as search*, Artificial Intelligence 18, 1982.
* B. Ganter and S. O. Kuznetsov, *Pattern structures and their projections*, 2001.
-/

namespace MathlibLattice.Query

variable {G P : Type*} [Preorder P] {τ : G → P} {Q N : Set G} {u : P}

/-! ### The concept generated by the positive objects -/

/-- In the context of a corpus `τ : G → P`, the descriptions common to the objects of `Q` are the
upper bounds of their terms. Through this the statements of `MathlibLattice.Query` on a general
context read as statements on the terms of the corpus. -/
theorem upperPolar_eq_upperBounds_image (τ : G → P) (Q : Set G) :
    upperPolar (fun g p => τ g ≤ p) Q = upperBounds (τ '' Q) := by
  simp [Set.ext_iff, mem_upperPolar_iff, mem_upperBounds]

/-- In the context of a corpus, a concept is the attribute concept of the description `u` if and
only if `u` is an upper bound of the terms of its extent and every object whose term lies below
`u` belongs to its extent. This is `ofObjects_eq_ofAttribute_iff` for the extent of the concept,
read through `upperPolar_eq_upperBounds_image`. -/
theorem eq_ofAttribute_iff_mem_upperBounds {c : Concept G P fun g p => τ g ≤ p} :
    c = Concept.ofAttribute _ u ↔
      u ∈ upperBounds (τ '' c.extent) ∧ ∀ g, τ g ≤ u → g ∈ c.extent := by
  simp [le_antisymm_iff, ← Concept.extent_subset_extent_iff, Set.subset_def, mem_upperBounds]

/-- In the context of a corpus, the concept generated by `Q` is the attribute concept of the
description `u` if and only if `u` is an upper bound of the terms of `Q` and every object whose
term lies below `u` belongs to the extent of the concept generated by `Q`. This is
`ofObjects_eq_ofAttribute_iff` read through `upperPolar_eq_upperBounds_image`. -/
theorem ofObjects_eq_ofAttribute_iff_mem_upperBounds :
    Concept.ofObjects (fun g p => τ g ≤ p) Q = Concept.ofAttribute _ u ↔
      u ∈ upperBounds (τ '' Q) ∧
        ∀ g, τ g ≤ u → g ∈ (Concept.ofObjects (fun g p => τ g ≤ p) Q).extent := by
  simp [eq_ofAttribute_iff_mem_upperBounds, ← upperPolar_eq_upperBounds_image]

/-- In the context of a corpus `τ : G → P`, where the object `g` has the description `p` when
`τ g ≤ p`, the descriptions common to the objects of `Q` are the elements above a least upper
bound `u` of their terms. No nonemptiness of `Q` is needed. -/
theorem intent_ofObjects_of_isLUB (hu : IsLUB (τ '' Q) u) :
    (Concept.ofObjects (fun g p => τ g ≤ p) Q).intent = Set.Ici u :=
  (upperPolar_eq_upperBounds_image τ Q).trans hu.upperBounds_eq

/-- In the context of a corpus, the extent of the concept generated by `Q` is the set of objects
whose terms lie below a least upper bound `u` of the terms of `Q`. No nonemptiness of `Q` is
needed. -/
theorem extent_ofObjects_of_isLUB (hu : IsLUB (τ '' Q) u) :
    (Concept.ofObjects (fun g p => τ g ≤ p) Q).extent = {g | τ g ≤ u} := by
  rw [← Concept.lowerPolar_intent, intent_ofObjects_of_isLUB hu]
  exact Set.ext fun _ => forall_ge_iff_le

/-- In the context of a corpus, the concept generated by `Q` is the attribute concept of a least
upper bound `u` of the terms of `Q`: the least general generalization of `Q` is the concept of
the description `u`. This is the case of `ofObjects_eq_ofAttribute_iff_mem_upperBounds` in which
`u` lies below every upper bound of the terms of `Q`. -/
theorem ofObjects_eq_ofAttribute_of_isLUB (hu : IsLUB (τ '' Q) u) :
    Concept.ofObjects (fun g p => τ g ≤ p) Q = Concept.ofAttribute _ u :=
  ofObjects_eq_ofAttribute_iff_mem_upperBounds.2
    ⟨hu.1, fun _ hg => (extent_ofObjects_of_isLUB hu).ge hg⟩

/-- In the context of a corpus, a concept whose extent has terms with a least upper bound `u` is
the attribute concept of `u`: by `eq_ofAttribute_iff_mem_upperBounds`, since an object whose term
lies below `u` lies below every upper bound of the terms of the extent, and so belongs to it. -/
theorem eq_ofAttribute_of_isLUB {c : Concept G P fun g p => τ g ≤ p}
    (hu : IsLUB (τ '' c.extent) u) : c = Concept.ofAttribute _ u :=
  Concept.ofObjects_extent.symm.trans (ofObjects_eq_ofAttribute_of_isLUB hu)

/-! ### Answers -/

/-- In the context of a corpus, some concept is consistent with the positive objects `Q` and the
negative objects `N` if and only if no negative object has its term below a least upper bound
`u` of the terms of `Q`. -/
theorem nonempty_consistentConcepts_iff_of_isLUB (hu : IsLUB (τ '' Q) u) :
    (consistentConcepts (fun g p => τ g ≤ p) Q N).Nonempty ↔ ∀ g ∈ N, ¬τ g ≤ u :=
  nonempty_consistentConcepts_iff.trans (extent_ofObjects_of_isLUB hu ▸ Set.disjoint_right)

/-- In the context of a corpus, if no negative object has its term below a least upper bound `u`
of the terms of `Q`, the attribute concept of `u` is the least consistent concept. -/
theorem isLeast_ofAttribute_of_isLUB (hu : IsLUB (τ '' Q) u) (hN : ∀ g ∈ N, ¬τ g ≤ u) :
    IsLeast (consistentConcepts (fun g p => τ g ≤ p) Q N) (Concept.ofAttribute _ u) :=
  ofObjects_eq_ofAttribute_of_isLUB hu ▸ ⟨⟨Concept.ofObjects_le_iff.1 le_rfl,
    (extent_ofObjects_of_isLUB hu).symm ▸ Set.disjoint_right.2 hN⟩,
      fun _ hc => Concept.ofObjects_le_iff.2 hc.1⟩

-- The hypothesis `hN` is needed: for two objects with incomparable terms `a` and `b`, `u = a`
-- and `Q = N` the first object, no concept is consistent, so both objects are certain
-- predictions, while only the first has its term below `a`.
/-- In the context of a corpus, if no negative object has its term below a least upper bound `u`
of the terms of `Q`, the certain predictions are the objects whose terms lie below `u`. -/
theorem certainPredictions_eq_of_isLUB (hu : IsLUB (τ '' Q) u) (hN : ∀ g ∈ N, ¬τ g ≤ u) :
    certainPredictions (fun g p => τ g ≤ p) Q N = {g | τ g ≤ u} :=
  (VersionSpace.certainPredictions_eq_of_isLeast Concept.strictMono_extent.monotone
    ((ofObjects_eq_ofAttribute_of_isLUB hu).symm ▸ isLeast_ofAttribute_of_isLUB hu hN)).trans
      (extent_ofObjects_of_isLUB hu)

/-- In the context of a corpus, the consistent concepts are the attribute concepts of the
descriptions above the term of every positive object and above the term of no negative object if
and only if every consistent concept is an attribute concept, that is, by
`eq_ofAttribute_iff_mem_upperBounds`, if and only if the extent of every consistent concept is the
set of objects whose terms lie below some upper bound of its terms. This is
`consistentConcepts_eq_image_ofAttribute_iff` read through `upperPolar_eq_upperBounds_image`. -/
theorem consistentConcepts_eq_image_ofAttribute_upperBounds_iff :
    consistentConcepts (fun g p => τ g ≤ p) Q N =
        Concept.ofAttribute _ '' {p | p ∈ upperBounds (τ '' Q) ∧ ∀ g ∈ N, ¬τ g ≤ p} ↔
      consistentConcepts (fun g p => τ g ≤ p) Q N ⊆ Set.range (Concept.ofAttribute _) :=
  upperPolar_eq_upperBounds_image τ Q ▸ consistentConcepts_eq_image_ofAttribute_iff

-- The hypothesis `h` cannot be dropped: for four objects with the terms `a₁, a₂, a₃, a₄` in the
-- preorder with two more elements `c > a₁, a₂, a₃` and `d > a₁, a₂, a₄`, the first two objects
-- positive and the last two negative, the concept with extent the first two objects is the only
-- consistent concept and is no attribute concept, and no description lies above `a₁` and `a₂` but
-- not above `a₃` or `a₄`, so the right side is empty.
/-- In the context of a corpus, if every consistent concept is an attribute concept, the most
general answers are the maximal attribute concepts of the descriptions above the term of every
positive object and above the term of no negative object. This is
`maximalConsistentConcepts_eq_of_subset_range_ofAttribute` read through
`upperPolar_eq_upperBounds_image`; if the concept lattice has no infinite increasing chain, it
suffices that every most general answer is an attribute concept
(`maximalConsistentConcepts_eq_iff_subset_range_ofAttribute`). -/
theorem maximalConsistentConcepts_eq_upperBounds_of_subset_range
    (h : consistentConcepts (fun g p => τ g ≤ p) Q N ⊆ Set.range (Concept.ofAttribute _)) :
    maximalConsistentConcepts (fun g p => τ g ≤ p) Q N =
      {c | Maximal (· ∈ Concept.ofAttribute _ ''
        {p | p ∈ upperBounds (τ '' Q) ∧ ∀ g ∈ N, ¬τ g ≤ p}) c} :=
  upperPolar_eq_upperBounds_image τ Q ▸ maximalConsistentConcepts_eq_of_subset_range_ofAttribute h

-- The hypothesis `hlub` is a sufficient condition for every consistent concept to be an attribute
-- concept (`eq_ofAttribute_of_isLUB`), the exact condition of
-- `consistentConcepts_eq_image_ofAttribute_upperBounds_iff`, and it is not necessary: for two
-- objects with the terms `a` and `b` in the preorder with two more elements `c` and `d`,
-- incomparable and above `a` and `b`, `Q` the first object and `N = ∅`, the consistent concepts
-- are the attribute concepts of `a` and of `c`, while `a` and `b` have no least upper bound. Some
-- hypothesis is needed, by the example before
-- `maximalConsistentConcepts_eq_upperBounds_of_subset_range`, where the left side is nonempty and
-- the right side is empty.
/-- In the context of a corpus, if the extent of every consistent concept has terms with a least
upper bound, the consistent concepts are the attribute concepts of the descriptions above the
term of every positive object and above the term of no negative object: every consistent concept
is then an attribute concept (`eq_ofAttribute_of_isLUB`), and
`consistentConcepts_eq_image_ofAttribute_upperBounds_iff` applies. -/
theorem consistentConcepts_eq_image_ofAttribute_of_isLUB
    (hlub : ∀ c ∈ consistentConcepts (fun g p => τ g ≤ p) Q N, ∃ u, IsLUB (τ '' c.extent) u) :
    consistentConcepts (fun g p => τ g ≤ p) Q N =
      Concept.ofAttribute _ '' {p | p ∈ upperBounds (τ '' Q) ∧ ∀ g ∈ N, ¬τ g ≤ p} :=
  consistentConcepts_eq_image_ofAttribute_upperBounds_iff.2 fun c hc =>
    (hlub c hc).imp fun _ hu => (eq_ofAttribute_of_isLUB hu).symm

-- The hypothesis `hlub` is sufficient and not necessary, and some hypothesis is needed, by the
-- examples before `consistentConcepts_eq_image_ofAttribute_of_isLUB`: in the first, both sides are
-- the set whose one element is the attribute concept of `c`.
/-- In the context of a corpus, if the extent of every consistent concept has terms with a least
upper bound, the most general answers are the maximal attribute concepts of the descriptions
above the term of every positive object and above the term of no negative object: every
consistent concept is then an attribute concept (`eq_ofAttribute_of_isLUB`), and
`maximalConsistentConcepts_eq_upperBounds_of_subset_range` applies. -/
theorem maximalConsistentConcepts_eq_of_isLUB
    (hlub : ∀ c ∈ consistentConcepts (fun g p => τ g ≤ p) Q N, ∃ u, IsLUB (τ '' c.extent) u) :
    maximalConsistentConcepts (fun g p => τ g ≤ p) Q N =
      {c | Maximal (· ∈ Concept.ofAttribute _ ''
        {p | p ∈ upperBounds (τ '' Q) ∧ ∀ g ∈ N, ¬τ g ≤ p}) c} :=
  maximalConsistentConcepts_eq_upperBounds_of_subset_range fun c hc =>
    (hlub c hc).imp fun _ hu => (eq_ofAttribute_of_isLUB hu).symm

/-! ### Pattern structures -/

section PatternStructure

-- The descriptions of the objects of every set have a meet (`PatternStructure.IsGLBDescr`,
-- Ganter–Kuznetsov 2001), as in every complete meet-semilattice of descriptions, at every level
-- of the height filtration of such a semilattice, and for a finite corpus of clauses. This is
-- what makes `PatternStructure.descr δ Q` a least upper bound in the order dual of `D`, and it is
-- needed: with the infimum on `Bool` that is constantly `true`, the description of `Set.univ`
-- under `fun _ : Unit => false` is `true`, whose attribute concept has extent `∅`, while the
-- concept generated by `Set.univ` has extent `Set.univ`.
variable {D : Type*} [Preorder D] [InfSet D] {δ : G → D} [PatternStructure.IsGLBDescr δ]

/-- In the representation context of a pattern structure `δ : G → D` (Ganter–Kuznetsov 2001),
where the object `g` has the description `d` when `d ≤ δ g`, the concept generated by `Q` is the
attribute concept of the description `PatternStructure.descr δ Q` of `Q`. This is the query over
a corpus in the order dual of `D`, where the description of `Q` is a least upper bound of the
descriptions of its objects (`PatternStructure.isGLB_descr`); it applies to every level
`MathlibLattice.Height.level ψ δ k` of the height filtration. -/
theorem ofObjects_eq_ofAttribute_descr (δ : G → D) [PatternStructure.IsGLBDescr δ] (Q : Set G) :
    Concept.ofObjects (fun g d => d ≤ δ g) Q =
      Concept.ofAttribute _ (PatternStructure.descr δ Q) :=
  ofObjects_eq_ofAttribute_of_isLUB (τ := OrderDual.toDual ∘ δ)
    (PatternStructure.isGLB_descr δ Q).dual

/-- In the representation context of a pattern structure, some concept is consistent with `Q`
and `N` if and only if the description of no negative object carries the information of the
description of `Q`: `nonempty_consistentConcepts_iff_of_isLUB` in the order dual. -/
theorem nonempty_consistentConcepts_iff_descr :
    (consistentConcepts (fun g d => d ≤ δ g) Q N).Nonempty ↔
      ∀ g ∈ N, ¬PatternStructure.descr δ Q ≤ δ g :=
  nonempty_consistentConcepts_iff_of_isLUB (τ := OrderDual.toDual ∘ δ)
    (PatternStructure.isGLB_descr δ Q).dual

-- The hypothesis `hN` is needed, as for `certainPredictions_eq_of_isLUB`: if no concept is
-- consistent, every object is a certain prediction.
/-- In the representation context of a pattern structure, if the description of no negative
object carries the information of the description of `Q`, the certain predictions are the
objects whose descriptions carry it, the extent of the description of `Q`:
`certainPredictions_eq_of_isLUB` in the order dual. -/
theorem certainPredictions_eq_extentOf_descr
    (hN : ∀ g ∈ N, ¬PatternStructure.descr δ Q ≤ δ g) :
    certainPredictions (fun g d => d ≤ δ g) Q N =
      PatternStructure.extentOf δ (PatternStructure.descr δ Q) :=
  certainPredictions_eq_of_isLUB (τ := OrderDual.toDual ∘ δ)
    (PatternStructure.isGLB_descr δ Q).dual hN

end PatternStructure

/-! ### Unstated concepts -/

/-- In the context of a corpus, a concept whose extent has terms with a least upper bound `u` is
unstated if and only if `u` is equivalent to the term of no object. No nonemptiness of the
extent is needed. -/
theorem isUnstated_iff_of_isLUB {c : Concept G P fun g p => τ g ≤ p}
    (hu : IsLUB (τ '' c.extent) u) : IsUnstated _ c ↔ ∀ g, ¬AntisymmRel (· ≤ ·) u (τ g) := by
  rw [IsUnstated, Set.mem_range, not_exists]
  refine forall_congr' fun g => not_congr ?_
  rw [← Concept.intent_injective.eq_iff, ← c.upperPolar_extent, upperPolar_eq_upperBounds_image,
    hu.upperBounds_eq, Concept.intent_ofObjects, upperPolar_eq_upperBounds_image]
  simp [Set.Subset.antisymm_iff, AntisymmRel]

/-! ### The generalizations of the corpus -/

/-- The context of a corpus `τ : G → P` on the generalizations of its terms, taken up to
equivalence: its attributes are the classes in `Antisymmetrization P (· ≤ ·)` above the class of
the term of some object, and the object `g` has the class `x` when the term of `g` lies below
`x`. -/
def generalizationContext (τ : G → P) :
    G → {x : Antisymmetrization P (· ≤ ·) // ∃ g, toAntisymmetrization (· ≤ ·) (τ g) ≤ x} →
      Prop :=
  fun g x => toAntisymmetrization (· ≤ ·) (τ g) ≤ x.1

/-- The object `g` has the class `x` in the generalization context when the term of `g` lies
below `x`. -/
@[simp]
theorem generalizationContext_apply {g : G}
    {x : {x : Antisymmetrization P (· ≤ ·) // ∃ g, toAntisymmetrization (· ≤ ·) (τ g) ≤ x}} :
    generalizationContext τ g x ↔ toAntisymmetrization (· ≤ ·) (τ g) ≤ x.1 :=
  Iff.rfl

/-- The extent of a set of classes in the generalization context is that of representatives. -/
private lemma lowerPolar_generalizationContext
    (T : Set {x : Antisymmetrization P (· ≤ ·) // ∃ g, toAntisymmetrization (· ≤ ·) (τ g) ≤ x}) :
    lowerPolar (generalizationContext τ) T =
      lowerPolar (fun g p => τ g ≤ p) ((fun x => ofAntisymmetrization (· ≤ ·) x.1) '' T) :=
  Set.ext fun _ => (Set.forall_mem_image.trans (forall₂_congr fun x _ =>
    toAntisymmetrization_le_toAntisymmetrization_iff.symm.trans
      (by rw [toAntisymmetrization_ofAntisymmetrization, generalizationContext_apply]))).symm

/-- A nonempty extent of the context of a corpus is the extent of the classes of its attributes. -/
private lemma lowerPolar_eq_lowerPolar_generalizationContext {T : Set P}
    (hT : (lowerPolar (fun g p => τ g ≤ p) T).Nonempty) :
    lowerPolar (fun g p => τ g ≤ p) T =
      lowerPolar (generalizationContext τ) (Subtype.val ⁻¹' (toAntisymmetrization (· ≤ ·) '' T)) :=
  hT.elim fun g₀ hg₀ => Set.ext fun _ => ⟨fun hg _ ⟨_, hp, hx⟩ => generalizationContext_apply.2
      (hx ▸ toAntisymmetrization_le_toAntisymmetrization_iff.2 (hg hp)),
    fun hg p hp => toAntisymmetrization_le_toAntisymmetrization_iff.1
      (hg (b := ⟨_, g₀, toAntisymmetrization_le_toAntisymmetrization_iff.2 (hg₀ hp)⟩)
        ⟨p, hp, rfl⟩)⟩

-- Nonemptiness is needed: for the corpus of one object described by `a` in the two-element
-- antichain `{a, b}`, the empty set is an extent of the context of the corpus, the set of objects
-- whose terms lie below both `a` and `b`, but not of the generalization context, whose only
-- attribute is the class of `a`.
/-- The generalizations of the terms of a corpus suffice: a nonempty set of objects is an extent
of the generalization context if and only if it is an extent of the context of the corpus. -/
theorem isExtent_generalizationContext_iff {A : Set G} (hA : A.Nonempty) :
    Order.IsExtent (generalizationContext τ) A ↔ Order.IsExtent (fun g p => τ g ≤ p) A :=
  ⟨fun ⟨_, hT⟩ => ⟨_, (lowerPolar_generalizationContext _).symm.trans hT⟩,
    fun ⟨_, hT⟩ => ⟨_, (lowerPolar_eq_lowerPolar_generalizationContext (hT ▸ hA)).symm.trans hT⟩⟩

/-- The extents of the consistent concepts are the extents containing `Q` and missing `N`. -/
private lemma image_extent_consistentConcepts {β : Type*} (r : G → β → Prop) (Q N : Set G) :
    Concept.extent '' consistentConcepts r Q N = {A | Order.IsExtent r A ∧ Q ⊆ A ∧ Disjoint A N} :=
  Set.ext fun _ => ⟨fun ⟨c, hc, h⟩ => h ▸ ⟨c.isExtent_extent, hc⟩,
    fun ⟨hA, hc⟩ => ⟨Concept.ofIsExtent r _ hA, hc, rfl⟩⟩

-- Nonemptiness is needed: in the example before `isExtent_generalizationContext_iff`, for `Q = ∅`
-- and `N` the one object, the concept of the corpus with empty extent is consistent, while no
-- concept of the generalization context is.
/-- The generalizations of the terms of a corpus suffice for the query: for nonempty `Q`, the
extents of the concepts consistent with `Q` and `N` are the same in the generalization context and
in the context of the corpus. Every such extent contains `Q`, so it is nonempty, and
`isExtent_generalizationContext_iff` applies. -/
theorem image_extent_consistentConcepts_generalizationContext (hQ : Q.Nonempty) :
    Concept.extent '' consistentConcepts (generalizationContext τ) Q N =
      Concept.extent '' consistentConcepts (fun g (p : P) => τ g ≤ p) Q N := by
  rw [image_extent_consistentConcepts, image_extent_consistentConcepts]
  exact Set.ext fun _ => and_congr_left fun h => isExtent_generalizationContext_iff (hQ.mono h.1)

/-- The extents of the maximal concepts of a set are the maximal extents of its concepts. -/
private lemma image_extent_setOf_maximal {β : Type*} {r : G → β → Prop} (V : Set (Concept G β r)) :
    Concept.extent '' {c | Maximal (· ∈ V) c} = {A | Maximal (· ∈ Concept.extent '' V) A} :=
  Set.ext fun _ => ⟨fun ⟨_, hc, h⟩ => h ▸ (maximal_mem_image_monotone_iff hc.prop
      fun _ _ _ _ => Concept.extent_subset_extent_iff).2 hc,
    fun hA => hA.prop.elim fun c ⟨hc, h⟩ => ⟨c, (maximal_mem_image_monotone_iff hc
      fun _ _ _ _ => Concept.extent_subset_extent_iff).1 (h ▸ hA), h⟩⟩

-- Nonemptiness is needed, by the example before
-- `image_extent_consistentConcepts_generalizationContext`.
/-- For nonempty `Q`, the extents of the most general answers are the same in the generalization
context and in the context of the corpus: both concept lattices are ordered by extent inclusion,
and their consistent concepts have the same extents
(`image_extent_consistentConcepts_generalizationContext`). So the results on contexts with
finitely many attributes give the most general answers of a corpus whose terms have finitely many
classes of generalizations. -/
theorem image_extent_maximalConsistentConcepts_generalizationContext (hQ : Q.Nonempty) :
    Concept.extent '' maximalConsistentConcepts (generalizationContext τ) Q N =
      Concept.extent '' maximalConsistentConcepts (fun g (p : P) => τ g ≤ p) Q N := by
  rw [image_extent_setOf_maximal, image_extent_setOf_maximal,
    image_extent_consistentConcepts_generalizationContext hQ]

-- Each hypothesis is needed: infinitely many objects with pairwise incomparable terms, and one
-- object whose term lies below infinitely many classes, give infinitely many classes of
-- generalizations.
/-- A finite corpus in which every term has finitely many generalizations up to equivalence has
finitely many classes of generalizations, so its generalization context has finitely many
attributes and finitely many concepts. -/
theorem finite_generalizations [Finite G]
    (h : ∀ g, (Set.Ici (toAntisymmetrization (· ≤ ·) (τ g))).Finite) :
    Finite {x : Antisymmetrization P (· ≤ ·) // ∃ g, toAntisymmetrization (· ≤ ·) (τ g) ≤ x} :=
  Set.Finite.to_subtype (s := {x | ∃ g, toAntisymmetrization (· ≤ ·) (τ g) ≤ x})
    ((Set.finite_iUnion h).subset fun _ ⟨g, hg⟩ => Set.mem_iUnion.2 ⟨g, hg⟩)

end MathlibLattice.Query
