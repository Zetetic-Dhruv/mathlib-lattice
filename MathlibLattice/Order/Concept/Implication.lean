import Mathlib.Order.Concept
import Mathlib.Order.Closure
import Mathlib.Data.Set.Card
import Mathlib.Data.List.TFAE

-- The library's files carry no copyright header.
set_option linter.style.header false

/-!
# Implications between attributes and the Duquenne–Guigues base

An implication `A → B` between sets of attributes holds in a formal context `r : α → β → Prop`
when every object having all attributes of `A` has all attributes of `B`. We define
implications, the closure operator generated by a set of implications, entailment, complete and
irredundant sets of implications, the pseudo-closed sets of a closure operator on the subsets of
a finite type, and its canonical base. For a context, the pseudo-closed sets of the intent
closure are the pseudo-intents, and the canonical base is the Duquenne–Guigues base.

## Main statements

* `Implication.holdsIn_iff_subset_intentClosure`: an implication holds if and only if its
  conclusion is contained in the intent closure of its premise.
* `ClosureOperator.closure_canonicalBase`: the canonical base generates its closure operator.
* `ClosureOperator.isIrredundant_canonicalBase`: the canonical base is irredundant.
* `ClosureOperator.exists_mem_premise_subset`: every set of implications generating a closure
  operator contains, for each pseudo-closed set `P`, an implication whose premise lies in `P` and
  has the same closure as `P`.
* `ClosureOperator.ncard_canonicalBase_le`: the canonical base has the least number of
  implications among all sets of implications generating the closure operator.
* `Implication.closure_setOf_conclusion_subset`, `ClosureOperator.intentClosure_mem_eq`: every
  closure operator on the subsets of a type is generated by implications and is the intent
  closure of a context; `Implication.closure_eq_closure_iff`: two sets of implications generate
  the same closure operator iff they entail the same implications.
* `Implication.tfae_closure_system`: closure systems, families of sets respecting a set of
  implications, and intent families of contexts are the same families.
* `Implication.closure_dgBase`, `Implication.isComplete_dgBase`,
  `Implication.isIrredundant_dgBase`, `Implication.ncard_dgBase_le`: the Duquenne–Guigues base
  of a context with finitely many attributes is complete, irredundant and of least
  cardinality.

## References

* J.-L. Guigues and V. Duquenne, *Familles minimales d'implications informatives résultant d'un
  tableau de données binaires*, Mathématiques et Sciences Humaines 95 (1986).
* B. Ganter and R. Wille, *Formal Concept Analysis: Mathematical Foundations*, Springer, 1999.
* B. Ganter and S. Obiedkov, *Conceptual Exploration*, Springer, 2016.
-/

/-- An implication between attributes: a premise and a conclusion, both sets of attributes
(Ganter–Wille 1999). -/
@[ext]
structure Implication (β : Type*) where
  /-- The premise of the implication. -/
  premise : Set β
  /-- The conclusion of the implication. -/
  conclusion : Set β

namespace Implication

variable {α β : Type*}

/-- A set `T` of attributes respects the implication `i` if `T` contains the conclusion of `i`
whenever it contains the premise of `i` (Ganter–Wille 1999). -/
def Respects (T : Set β) (i : Implication β) : Prop :=
  i.premise ⊆ T → i.conclusion ⊆ T

/-- The implication `i` holds in the context `r` if the attribute set of every object respects
`i`: every object having all attributes of the premise has all attributes of the conclusion
(Ganter–Wille 1999). -/
def HoldsIn (r : α → β → Prop) (i : Implication β) : Prop :=
  ∀ a, Respects {b | r a b} i

/-- The sets of attributes respecting every implication of `L` are closed under arbitrary
intersections. -/
theorem respects_sInf {L : Set (Implication β)} (S : Set (Set β))
    (hS : ∀ T ∈ S, ∀ i ∈ L, Respects T i) : ∀ i ∈ L, Respects (sInf S) i :=
  fun i hi h => Set.subset_sInter fun T hT =>
    hS T hT i hi (h.trans (Set.sInter_subset_of_mem hT))

/-- The closure operator generated by a set `L` of implications: the closure of `T` is the least
superset of `T` that respects every implication of `L`. -/
def closure (L : Set (Implication β)) : ClosureOperator (Set β) :=
  ClosureOperator.ofCompletePred (fun T => ∀ i ∈ L, Respects T i) respects_sInf

/-- A set `L` of implications entails the implication `i` if every set of attributes respecting
all implications of `L` respects `i` (Ganter–Wille 1999). -/
def Entails (L : Set (Implication β)) (i : Implication β) : Prop :=
  ∀ T, (∀ j ∈ L, Respects T j) → Respects T i

/-- A set `L` of implications is complete for the context `r` if the implications entailed by `L`
are exactly the implications holding in `r`: every implication of `L` holds in `r`, and every
implication holding in `r` is entailed by `L` (Ganter–Wille 1999). -/
def IsComplete (r : α → β → Prop) (L : Set (Implication β)) : Prop :=
  ∀ i, Entails L i ↔ HoldsIn r i

/-- A set `L` of implications is irredundant if no implication of `L` is entailed by the other
implications of `L` (Ganter–Wille 1999). -/
def IsIrredundant (L : Set (Implication β)) : Prop :=
  ∀ i ∈ L, ¬ Entails (L \ {i}) i

/-- The closed sets of the closure operator generated by `L` are the sets respecting every
implication of `L`. -/
theorem isClosed_closure_iff {L : Set (Implication β)} {T : Set β} :
    (closure L).IsClosed T ↔ ∀ i ∈ L, Respects T i :=
  Iff.of_eq (ClosureOperator.ofCompletePred_isClosed _ _ _)

/-- A set `L` of implications entails `i` iff the conclusion of `i` lies in the closure of the
premise of `i` under `L`. -/
theorem entails_iff_subset_closure {L : Set (Implication β)} {i : Implication β} :
    Entails L i ↔ i.conclusion ⊆ closure L i.premise :=
  ⟨fun h => h _ (isClosed_closure_iff.1 ((closure L).isClosed_closure _))
      ((closure L).le_closure _),
    fun h _ hT hi => h.trans ((isClosed_closure_iff.2 hT).closure_le_iff.2 hi)⟩

/-- An implication holds in the context `r` if and only if its conclusion is contained in the
intent closure of its premise (Ganter–Wille 1999). -/
theorem holdsIn_iff_subset_intentClosure {r : α → β → Prop} {i : Implication β} :
    HoldsIn r i ↔ i.conclusion ⊆ intentClosure r i.premise := by
  tauto

/-- Closure operators `c` and `d` are equal iff `B ⊆ c A ↔ B ⊆ d A` for each implication `A → B`. -/
private lemma forall_conclusion_subset_iff {c d : ClosureOperator (Set β)} :
    (∀ i : Implication β, i.conclusion ⊆ c i.premise ↔ i.conclusion ⊆ d i.premise) ↔ c = d :=
  ⟨fun h => ClosureOperator.ext _ _ fun A => eq_of_forall_le_iff fun B => h ⟨A, B⟩,
    fun h _ => h ▸ Iff.rfl⟩

/-- A set of implications is complete for the context `r` iff it generates the intent closure
of `r`. -/
theorem isComplete_iff_closure_eq {r : α → β → Prop} {L : Set (Implication β)} :
    IsComplete r L ↔ closure L = intentClosure r :=
  (forall_congr' fun _ => iff_congr entails_iff_subset_closure
    holdsIn_iff_subset_intentClosure).trans forall_conclusion_subset_iff

/-- The implications holding in a context generate its intent closure: a set of attributes is an
intent iff it respects every implication holding in the context (Ganter–Wille 1999). -/
theorem closure_setOf_holdsIn (r : α → β → Prop) :
    closure {i | HoldsIn r i} = intentClosure r :=
  isComplete_iff_closure_eq.1 fun _ => ⟨fun h a => h _ fun _ hj => hj a, fun h _ hT => hT _ h⟩

/-- Every closure operator `c` on the subsets of `β` is generated by the implications `A → B`
with `B ⊆ c A`. -/
theorem closure_setOf_conclusion_subset (c : ClosureOperator (Set β)) :
    closure {i | i.conclusion ⊆ c i.premise} = c :=
  ClosureOperator.ext_isClosed _ _ fun T => isClosed_closure_iff.trans
    ⟨fun h => c.isClosed_iff_closure_le.2 (h ⟨T, c T⟩ Set.Subset.rfl Set.Subset.rfl),
      fun h _ hi hiT => hi.trans (h.closure_le_iff.2 hiT)⟩

/-- Two sets of implications generate the same closure operator iff they entail the same
implications. -/
theorem closure_eq_closure_iff {L L' : Set (Implication β)} :
    closure L = closure L' ↔ ∀ i, Entails L i ↔ Entails L' i :=
  forall_conclusion_subset_iff.symm.trans
    (forall_congr' fun _ => iff_congr entails_iff_subset_closure entails_iff_subset_closure).symm

/-- With finitely many attributes, every set of implications is finite. -/
private lemma finite_of_finite_attributes [Finite β] (L : Set (Implication β)) : L.Finite :=
  (Set.toFinite ((fun i : Implication β => (i.premise, i.conclusion)) '' L)).of_finite_image
    fun _ _ _ _ h => Implication.ext_iff.2 (Prod.ext_iff.1 h)

end Implication

namespace ClosureOperator

variable {α β : Type*}

/-- Every closure operator `c` on the subsets of `β` is the intent closure of a context: the
objects are the sets of attributes, and the object `T` has the attributes of `c T`. -/
theorem intentClosure_mem_eq (c : ClosureOperator (Set β)) :
    intentClosure (fun (T : Set β) (b : β) => b ∈ c T) = c :=
  ClosureOperator.ext _ _ fun A => Set.ext fun _ =>
    ⟨fun h => h (c.le_closure A), fun hb _ hT => c.le_closure_iff.1 hT hb⟩

/-- A set `P` of attributes is pseudo-closed for a closure operator `c` on the subsets of a
finite type if `P` is not closed and contains the closure of every pseudo-closed proper subset
of `P` (Guigues–Duquenne 1986; Ganter–Obiedkov 2016). The definition is by well-founded
recursion on the cardinality of `P`. -/
def IsPseudoClosed [Finite β] (c : ClosureOperator (Set β)) (P : Set β) : Prop :=
  P ≠ c P ∧ ∀ Q, Q ⊂ P → IsPseudoClosed c Q → c Q ⊆ P
termination_by P.ncard
decreasing_by exact Set.ncard_lt_ncard ‹_›

/-- The canonical base of a closure operator `c` on the subsets of a finite type: the
implications `P → c P` for the pseudo-closed sets `P` of `c` (Guigues–Duquenne 1986). -/
def canonicalBase [Finite β] (c : ClosureOperator (Set β)) : Set (Implication β) :=
  (fun P => ⟨P, c P⟩) '' {P | c.IsPseudoClosed P}

/-- The defining recursion of pseudo-closed sets: `P` is pseudo-closed iff `P` is not closed and
contains the closure of every pseudo-closed proper subset. -/
theorem isPseudoClosed_iff [Finite β] {c : ClosureOperator (Set β)} {P : Set β} :
    c.IsPseudoClosed P ↔ P ≠ c P ∧ ∀ Q, Q ⊂ P → c.IsPseudoClosed Q → c Q ⊆ P :=
  Iff.of_eq (IsPseudoClosed.eq_1 c P)

/-- An implication belongs to the canonical base of `c` iff its premise is pseudo-closed and its
conclusion is the closure of its premise. -/
theorem mem_canonicalBase [Finite β] {c : ClosureOperator (Set β)} {i : Implication β} :
    i ∈ c.canonicalBase ↔ c.IsPseudoClosed i.premise ∧ i.conclusion = c i.premise := by
  simp [canonicalBase, Implication.ext_iff, eq_comm]

/-- For pseudo-closed `P` and `Z ⊂ P` containing `c Q` for pseudo-closed `Q ⊂ Z`, `c Z ⊆ P`. -/
private lemma IsPseudoClosed.closure_subset_of_ssubset [Finite β] {c : ClosureOperator (Set β)}
    {P Z : Set β} (hP : c.IsPseudoClosed P) (hZP : Z ⊂ P)
    (hZ : ∀ Q, Q ⊂ Z → c.IsPseudoClosed Q → c Q ⊆ Z) : c Z ⊆ P :=
  (eq_or_ne Z (c Z)).elim (fun h => h.symm.subset.trans hZP.subset)
    fun h => (isPseudoClosed_iff.1 hP).2 Z hZP (isPseudoClosed_iff.2 ⟨h, hZ⟩)

/-- A pseudo-closed set is quasi-closed: every subset `Q` of a pseudo-closed set `P` has its
closure contained in `P` or equal to the closure of `P` (Guigues–Duquenne 1986). -/
theorem IsPseudoClosed.closure_subset_or_eq [Finite β] {c : ClosureOperator (Set β)}
    {P Q : Set β} (hP : c.IsPseudoClosed P) (hQ : Q ⊆ P) : c Q ⊆ P ∨ c Q = c P := by
  obtain h | h := (Set.inter_subset_left : P ∩ c Q ⊆ P).ssubset_or_eq
  · refine .inl ((c.monotone (Set.subset_inter hQ (c.le_closure Q))).trans
      (hP.closure_subset_of_ssubset h fun R hR hRc => Set.subset_inter ?_ ?_))
    · exact (isPseudoClosed_iff.1 hP).2 R (hR.trans_subset Set.inter_subset_left) hRc
    · exact c.le_closure_iff.1 (hR.subset.trans Set.inter_subset_right)
  · exact .inr ((c.monotone hQ).antisymm (c.le_closure_iff.1 (Set.inter_eq_left.1 h)))

/-- A pseudo-closed `P` lies in a pseudo-closed `Q` when some `A ⊆ P ∩ Q` has `c A = c P`. -/
private lemma IsPseudoClosed.subset_of_subset_of_closure_eq [Finite β]
    {c : ClosureOperator (Set β)} {P Q A : Set β} (hP : c.IsPseudoClosed P)
    (hQ : c.IsPseudoClosed Q) (hAP : A ⊆ P) (hAQ : A ⊆ Q) (hcP : c A = c P) : P ⊆ Q := by
  obtain h | h := (Set.inter_subset_left : P ∩ Q ⊆ P).ssubset_or_eq
  · refine absurd ((c.le_closure P).antisymm ?_) (isPseudoClosed_iff.1 hP).1
    exact hcP ▸ (c.monotone (Set.subset_inter hAP hAQ)).trans
      (hP.closure_subset_of_ssubset h fun R hR hRc => Set.subset_inter
        ((isPseudoClosed_iff.1 hP).2 R (hR.trans_subset Set.inter_subset_left) hRc)
        ((isPseudoClosed_iff.1 hQ).2 R (hR.trans_subset Set.inter_subset_right) hRc))
  · exact Set.inter_eq_left.1 h

/-- Two pseudo-closed sets that contain a common set having the same closure as both of them are
equal (Guigues–Duquenne 1986). -/
theorem IsPseudoClosed.eq_of_subset_of_closure_eq [Finite β] {c : ClosureOperator (Set β)}
    {P Q A : Set β} (hP : c.IsPseudoClosed P) (hQ : c.IsPseudoClosed Q) (hAP : A ⊆ P)
    (hAQ : A ⊆ Q) (hcP : c A = c P)
    -- needed: if `∅` is pseudo-closed, take `A = P = ∅` and any other pseudo-closed `Q`
    (hcQ : c A = c Q) : P = Q :=
  (hP.subset_of_subset_of_closure_eq hQ hAP hAQ hcP).antisymm
    (hQ.subset_of_subset_of_closure_eq hP hAQ hAP hcQ)

/-- A set is closed for a closure operator on the subsets of a finite type iff it contains the
closure of every pseudo-closed set contained in it (Guigues–Duquenne 1986; Wild 2017,
Theorem 1(a)). -/
theorem isClosed_iff_forall_isPseudoClosed [Finite β] {c : ClosureOperator (Set β)}
    {T : Set β} : c.IsClosed T ↔ ∀ P, c.IsPseudoClosed P → P ⊆ T → c P ⊆ T :=
  ⟨fun h _ _ hPT => h.closure_le_iff.2 hPT, fun h => isClosed_iff_closure_le.2 <|
    (eq_or_ne T (c T)).elim Eq.ge fun hT =>
      h T (isPseudoClosed_iff.2 ⟨hT, fun Q hQT hQ => h Q hQ hQT.subset⟩) le_rfl⟩

/-- The canonical base of a closure operator on the subsets of a finite type generates it
(Guigues–Duquenne 1986). -/
theorem closure_canonicalBase [Finite β] (c : ClosureOperator (Set β)) :
    Implication.closure c.canonicalBase = c :=
  ClosureOperator.ext_isClosed _ _ fun _ => Implication.isClosed_closure_iff.trans
    (Set.forall_mem_image.trans isClosed_iff_forall_isPseudoClosed.symm)

/-- A pseudo-closed set `P` respects every implication of the canonical base other than
`P → c P`. -/
private lemma IsPseudoClosed.respects_of_mem_canonicalBase_diff [Finite β]
    {c : ClosureOperator (Set β)} {P : Set β} (hP : c.IsPseudoClosed P) :
    ∀ i ∈ c.canonicalBase \ {⟨P, c P⟩}, Implication.Respects P i := by
  rintro _ ⟨⟨Q, hQ, rfl⟩, hQP⟩ hQP'
  refine (isPseudoClosed_iff.1 hP).2 Q (hQP'.ssubset_of_ne ?_) hQ
  rintro rfl
  exact hQP (Set.mem_singleton _)

/-- A pseudo-closed set `P` is closed for the closure operator generated by the canonical base
without the implication `P → c P` (Guigues–Duquenne 1986; Ganter–Wille 1999, Theorem 8). -/
theorem IsPseudoClosed.isClosed_closure_canonicalBase_diff [Finite β]
    {c : ClosureOperator (Set β)} {P : Set β} (hP : c.IsPseudoClosed P) :
    (Implication.closure (c.canonicalBase \ {⟨P, c P⟩})).IsClosed P :=
  Implication.isClosed_closure_iff.2 hP.respects_of_mem_canonicalBase_diff

/-- The canonical base of a closure operator on the subsets of a finite type is irredundant
(Guigues–Duquenne 1986). -/
theorem isIrredundant_canonicalBase [Finite β] (c : ClosureOperator (Set β)) :
    Implication.IsIrredundant c.canonicalBase := by
  rintro _ ⟨P, hP, rfl⟩ h
  exact (isPseudoClosed_iff.1 hP).1 ((c.le_closure P).antisymm
    ((Implication.entails_iff_subset_closure.1 h).trans
      hP.isClosed_closure_canonicalBase_diff.closure_eq.le))

/-- Every set `L` of implications generating `c` contains, for each pseudo-closed set `P` of `c`,
an implication that `P` does not respect, whose premise is contained in `P` and has the same
closure as `P` (Guigues–Duquenne 1986). -/
theorem exists_mem_premise_subset [Finite β] {c : ClosureOperator (Set β)}
    {L : Set (Implication β)} (hL : Implication.closure L = c) {P : Set β}
    (hP : c.IsPseudoClosed P) :
    ∃ i ∈ L, i.premise ⊆ P ∧ ¬ i.conclusion ⊆ P ∧ c i.premise = c P := by
  subst hL
  obtain ⟨i, hi, hiP⟩ := not_forall₂.1 (mt Implication.isClosed_closure_iff.2 fun h =>
    (isPseudoClosed_iff.1 hP).1 h.closure_eq.symm)
  obtain ⟨hpP, hcP⟩ := Classical.not_imp.1 hiP
  exact ⟨i, hi, hpP, hcP, (hP.closure_subset_or_eq hpP).resolve_left fun h =>
    hcP ((Implication.entails_iff_subset_closure.1 fun _ hT => hT i hi).trans h)⟩

/-- A pseudo-closed set of `c` that contains `A` and has the same closure as `A`, chosen when one
exists. -/
private noncomputable def pseudoClosedOf [Finite β] (c : ClosureOperator (Set β)) (A : Set β) :
    Set β :=
  Classical.epsilon fun P => c.IsPseudoClosed P ∧ A ⊆ P ∧ c A = c P

/-- A pseudo-closed set `P` with `A ⊆ P` and `c A = c P` is `pseudoClosedOf c A`. -/
private lemma pseudoClosedOf_eq [Finite β] {c : ClosureOperator (Set β)} {A P : Set β}
    (hP : c.IsPseudoClosed P) (hAP : A ⊆ P) (hcP : c A = c P) : pseudoClosedOf c A = P := by
  obtain ⟨hQ, hAQ, hcQ⟩ := Classical.epsilon_spec (p := fun Q =>
    c.IsPseudoClosed Q ∧ A ⊆ Q ∧ c A = c Q) ⟨P, hP, hAP, hcP⟩
  exact hQ.eq_of_subset_of_closure_eq hP hAQ hAP hcQ hcP

/-- For `L` generating `c`, the map `i ↦ (pseudoClosedOf c i.premise → c i.premise)` sends the
implications of `L` whose premise has its closure in `S` onto the implications of the canonical
base whose premise has its closure in `S`. -/
private lemma surjOn_sep_canonicalBase [Finite β] {c : ClosureOperator (Set β)}
    {L : Set (Implication β)} (hL : Implication.closure L = c) (S : Set (Set β)) :
    Set.SurjOn (fun i => Implication.mk (pseudoClosedOf c i.premise) (c i.premise))
      {i ∈ L | c i.premise ∈ S} {i ∈ c.canonicalBase | c i.premise ∈ S} := by
  rintro _ ⟨⟨P, hP, rfl⟩, hPS⟩
  obtain ⟨i, hi, hiP, -, hcP⟩ := exists_mem_premise_subset hL hP
  exact ⟨i, ⟨hi, hcP ▸ hPS⟩, Implication.ext (pseudoClosedOf_eq hP hiP hcP) hcP⟩

/-- Minimality of the canonical base in every union of closure classes: for every set `L` of
implications generating `c` and every family `S` of sets, the canonical base has at most as many
implications whose premise has its closure in `S` as `L` has. For `S = {X}` this bounds each
closure class (Guigues–Duquenne 1986; Wild 2017, Theorem 1(b)). -/
theorem ncard_sep_canonicalBase_le [Finite β] {c : ClosureOperator (Set β)}
    {L : Set (Implication β)} (hL : Implication.closure L = c) (S : Set (Set β)) :
    {i ∈ c.canonicalBase | c i.premise ∈ S}.ncard ≤ {i ∈ L | c i.premise ∈ S}.ncard :=
  (Set.ncard_le_ncard (surjOn_sep_canonicalBase hL S)
    (Implication.finite_of_finite_attributes _)).trans
      (Set.ncard_image_le (Implication.finite_of_finite_attributes _))

/-- Minimality of the canonical base: every set of implications generating a closure operator on
the subsets of a finite type has at least as many implications as its canonical base
(Guigues–Duquenne 1986). -/
theorem ncard_canonicalBase_le [Finite β] {c : ClosureOperator (Set β)}
    {L : Set (Implication β)} (hL : Implication.closure L = c) :
    c.canonicalBase.ncard ≤ L.ncard := by
  simpa using ncard_sep_canonicalBase_le hL Set.univ

end ClosureOperator

namespace Implication

variable {α β : Type*}

/-- For a family `F` of sets of attributes the following are equivalent: `F` is closed under
arbitrary intersections; `F` is the family of closed sets of a closure operator; `F` is the
family of sets respecting every implication of some set of implications; `F` is the family of
intents of some context (Ganter–Wille 1999). -/
theorem tfae_closure_system (F : Set (Set β)) :
    List.TFAE [∀ S ⊆ F, ⋂₀ S ∈ F,
      ∃ c : ClosureOperator (Set β), {T | c.IsClosed T} = F,
      ∃ L : Set (Implication β), {T | ∀ i ∈ L, Respects T i} = F,
      ∃ r : Set β → β → Prop, {T | Order.IsIntent r T} = F] := by
  tfae_have 1 → 2 := fun h => ⟨.ofCompletePred (· ∈ F) h,
    Set.ext fun T => Iff.of_eq (ClosureOperator.ofCompletePred_isClosed (· ∈ F) h T)⟩
  tfae_have 2 → 4
  | ⟨c, hc⟩ => ⟨fun T b => b ∈ c T, by
      simp_rw [Order.isIntent_iff, ← intentClosure_isClosed,
        ClosureOperator.intentClosure_mem_eq, hc]⟩
  tfae_have 4 → 3
  | ⟨r, hr⟩ => ⟨{i | HoldsIn r i}, by
      simp_rw [← isClosed_closure_iff, closure_setOf_holdsIn, intentClosure_isClosed,
        ← Order.isIntent_iff, hr]⟩
  tfae_have 3 → 1
  | ⟨L, hL⟩ => hL ▸ fun S hS => respects_sInf S hS
  tfae_finish

end Implication

namespace Order

variable {α β : Type*}

/-- A pseudo-intent of a context `r` with finitely many attributes: a set `P` of attributes with
`P ≠ P''` such that `Q'' ⊆ P` for every pseudo-intent `Q ⊂ P`, where `''` is the intent
closure; that is, a pseudo-closed set of the intent closure (Guigues–Duquenne 1986). -/
abbrev IsPseudoIntent [Finite β] (r : α → β → Prop) (P : Set β) : Prop :=
  (intentClosure r).IsPseudoClosed P

/-- The defining recursion of pseudo-intents: `P` is a pseudo-intent iff `P ≠ P''` and
`Q'' ⊆ P` for every pseudo-intent `Q ⊂ P`. -/
theorem isPseudoIntent_iff [Finite β] {r : α → β → Prop} {P : Set β} :
    IsPseudoIntent r P ↔
      P ≠ intentClosure r P ∧ ∀ Q, Q ⊂ P → IsPseudoIntent r Q → intentClosure r Q ⊆ P :=
  ClosureOperator.isPseudoClosed_iff

end Order

namespace Implication

variable {α β : Type*}

/-- The Duquenne–Guigues base (stem base) of a context `r` with finitely many attributes: the
implications `P → P''` for the pseudo-intents `P` of `r` (Guigues–Duquenne 1986). -/
abbrev dgBase [Finite β] (r : α → β → Prop) : Set (Implication β) :=
  (intentClosure r).canonicalBase

/-- An implication belongs to the Duquenne–Guigues base of `r` iff its premise is a
pseudo-intent and its conclusion is the intent closure of its premise. -/
theorem mem_dgBase [Finite β] {r : α → β → Prop} {i : Implication β} :
    i ∈ dgBase r ↔ Order.IsPseudoIntent r i.premise ∧ i.conclusion = intentClosure r i.premise :=
  ClosureOperator.mem_canonicalBase

/-- The Duquenne–Guigues base of a context with finitely many attributes generates its intent
closure (Guigues–Duquenne 1986). -/
theorem closure_dgBase [Finite β] (r : α → β → Prop) :
    closure (dgBase r) = intentClosure r :=
  (intentClosure r).closure_canonicalBase

/-- The Duquenne–Guigues base of a context with finitely many attributes is complete: its
implications hold in the context and entail every implication holding in it
(Guigues–Duquenne 1986). -/
theorem isComplete_dgBase [Finite β] (r : α → β → Prop) : IsComplete r (dgBase r) :=
  isComplete_iff_closure_eq.2 (closure_dgBase r)

/-- The Duquenne–Guigues base of a context with finitely many attributes is irredundant
(Guigues–Duquenne 1986). -/
theorem isIrredundant_dgBase [Finite β] (r : α → β → Prop) : IsIrredundant (dgBase r) :=
  (intentClosure r).isIrredundant_canonicalBase

/-- Every complete set of implications of a context with finitely many attributes contains, for
each pseudo-intent `P`, an implication that `P` does not respect, whose premise is contained in
`P` and generates the same intent as `P` (Guigues–Duquenne 1986). -/
theorem exists_mem_premise_subset [Finite β] {r : α → β → Prop} {L : Set (Implication β)}
    (hL : IsComplete r L) {P : Set β} (hP : Order.IsPseudoIntent r P) :
    ∃ i ∈ L, i.premise ⊆ P ∧ ¬ i.conclusion ⊆ P ∧
      intentClosure r i.premise = intentClosure r P :=
  ClosureOperator.exists_mem_premise_subset (isComplete_iff_closure_eq.1 hL) hP

/-- Minimality of the Duquenne–Guigues base: every complete set of implications of a context with
finitely many attributes has at least as many implications as the Duquenne–Guigues base
(Guigues–Duquenne 1986). -/
theorem ncard_dgBase_le [Finite β] {r : α → β → Prop} {L : Set (Implication β)}
    -- needed, soundness included: `{∅ → Set.univ}` alone entails every implication
    (hL : IsComplete r L) : (dgBase r).ncard ≤ L.ncard :=
  ClosureOperator.ncard_canonicalBase_le (isComplete_iff_closure_eq.1 hL)

end Implication
