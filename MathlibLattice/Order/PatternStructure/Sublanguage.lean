import MathlibLattice.Order.PatternStructure.Projection

-- The library's files carry no copyright header.
set_option linter.style.header false

/-!
# Projections generated by sublanguages

Let `D` be a complete lattice of descriptions, ordered by information, and `S ⊆ D` a sublanguage.
Sending a description `d` to the join of the members of `S` below it is a projection
`PatternStructure.Projection.ofSubset S`: it keeps the information of `d` that `S` can express.
Its fixed points are the joins of subsets of `S`, and every projection of a complete lattice is
generated by its set of fixed points, so every projection is of this form. The extents of the
projected pattern structure are the extents of the formal context whose attributes are the members
of `S`. A larger sublanguage gives a projection that forgets less, so an increasing sequence of
sublanguages gives a chain of projections.

## Main definitions

* `PatternStructure.Projection.ofSubset S`: the projection generated by the sublanguage `S`.

## Main statements

* `PatternStructure.Projection.apply_sSup_eq_sSup`: the fixed points of a projection of a complete
  lattice are closed under joins.
* `PatternStructure.Projection.ofSubset_apply_eq_self_iff`: the fixed points of `ofSubset S` are
  the joins of subsets of `S`.
* `PatternStructure.Projection.eq_ofSubset_setOf_apply_eq_self`: every projection is generated by
  its fixed points.
* `PatternStructure.Projection.ofSubset_le_ofSubset_iff`: `ofSubset S` forgets at least as much as
  `ofSubset S'` iff every member of `S` is a join of members of `S'`.
* `PatternStructure.Projection.isExtent_project_ofSubset_iff`: the extents of the projected
  pattern structure are the extents of the context of the sublanguage.

## References

* B. Ganter, S. O. Kuznetsov, *Pattern structures and their projections*, 2001.
-/

namespace PatternStructure.Projection

variable {G D : Type*} [CompleteLattice D]

/-- The fixed points of a projection of a complete lattice are closed under joins: if every member
of `T` is fixed by `ψ`, so is `sSup T`. -/
theorem apply_sSup_eq_sSup (ψ : Projection D) {T : Set D} (hT : ∀ d ∈ T, ψ d = d) :
    ψ (sSup T) = sSup T :=
  le_antisymm (ψ.apply_le _)
    (sSup_le fun d hd => (hT d hd).symm.trans_le (ψ.monotone (le_sSup hd)))

/-- The projection generated by a sublanguage `S` of a complete lattice of descriptions: a
description `d` is sent to the join of the members of `S` below it, the information of `d` that
`S` can express. -/
noncomputable def ofSubset (S : Set D) : Projection D where
  toFun d := sSup {e | e ∈ S ∧ e ≤ d}
  monotone' _ _ h := sSup_le_sSup fun _ he => ⟨he.1, he.2.trans h⟩
  apply_le' _ := sSup_le fun _ he => he.2
  idempotent' _ := le_antisymm (sSup_le fun _ he => he.2)
    (sSup_le_sSup fun _ he => ⟨he.1, le_sSup he⟩)

/-- The projection generated by `S` sends `d` to the join of the members of `S` below `d`. -/
theorem ofSubset_apply (S : Set D) (d : D) : ofSubset S d = sSup {e | e ∈ S ∧ e ≤ d} :=
  rfl

/-- A member of `S` lies below `ofSubset S d` exactly when it lies below `d`. -/
theorem le_ofSubset_apply_iff {S : Set D} {e : D} (he : e ∈ S) (d : D) :
    e ≤ ofSubset S d ↔ e ≤ d :=
  ⟨fun h => h.trans ((ofSubset S).apply_le d), fun h => le_sSup ⟨he, h⟩⟩

/-- The projection generated by `S` fixes every member of `S`. -/
theorem ofSubset_apply_of_mem {S : Set D} {e : D} (he : e ∈ S) : ofSubset S e = e :=
  le_antisymm ((ofSubset S).apply_le e) ((le_ofSubset_apply_iff he e).2 le_rfl)

/-- The fixed points of the projection generated by `S` are the joins of subsets of `S`. -/
theorem ofSubset_apply_eq_self_iff {S : Set D} {d : D} :
    ofSubset S d = d ↔ ∃ T ⊆ S, sSup T = d :=
  ⟨fun h => ⟨{e | e ∈ S ∧ e ≤ d}, fun _ he => he.1, h⟩, fun ⟨_, hT, hd⟩ =>
    hd ▸ (ofSubset S).apply_sSup_eq_sSup fun _ he => ofSubset_apply_of_mem (hT he)⟩

/-- Every projection of a complete lattice is generated by its set of fixed points: `ψ d` is the
join of the fixed points below `d`. -/
theorem eq_ofSubset_setOf_apply_eq_self (ψ : Projection D) : ψ = ofSubset {d | ψ d = d} :=
  ext fun d => le_antisymm (le_sSup ⟨ψ.idempotent d, ψ.apply_le d⟩)
    (sSup_le fun _ he => he.1.symm.trans_le (ψ.monotone he.2))

/-- Comparison of sublanguages: `ofSubset S` forgets at least as much as `ofSubset S'` if and only
if every member of `S` is fixed by `ofSubset S'`, that is, is a join of members of `S'`. -/
theorem ofSubset_le_ofSubset_iff {S S' : Set D} :
    (∀ d, ofSubset S d ≤ ofSubset S' d) ↔ ∀ e ∈ S, ofSubset S' e = e :=
  ⟨fun h e he => ((ofSubset S').apply_le e).antisymm
    ((ofSubset_apply_of_mem he).symm.trans_le (h e)),
    fun h _ => sSup_le fun e he => (h e he.1).symm.trans_le ((ofSubset S').monotone he.2)⟩

/-- A larger sublanguage forgets less: if `S ⊆ S'`, then `ofSubset S d ≤ ofSubset S' d`. -/
theorem ofSubset_le_ofSubset {S S' : Set D} (h : S ⊆ S') (d : D) :
    ofSubset S d ≤ ofSubset S' d :=
  sSup_le_sSup fun _ he => ⟨h he.1, he.2⟩

/-- An increasing sequence of sublanguages gives a chain of projections:
`ofSubset (S k) d ≤ ofSubset (S (k + 1)) d`. -/
theorem ofSubset_le_ofSubset_succ {S : ℕ → Set D} (hS : Monotone S) (k : ℕ) (d : D) :
    ofSubset (S k) d ≤ ofSubset (S (k + 1)) d :=
  ofSubset_le_ofSubset (hS k.le_succ) d

/-- The extents of the pattern structure projected by `ofSubset S` are the extents of the formal
context `(G, S, fun g e => e ≤ δ g)`, whose attributes are the members of the sublanguage. -/
theorem isExtent_project_ofSubset_iff (S : Set D) (δ : G → D) {A : Set G} :
    IsExtent ((ofSubset S).project δ) A ↔ Order.IsExtent (fun g (e : S) => (e : D) ≤ δ g) A := by
  rw [isExtent_iff, descr_project, extentOf_project, Order.isExtent_iff]
  refine Eq.congr_left (Set.ext fun g => ?_)
  simp [ofSubset_apply, mem_lowerPolar_iff, mem_upperPolar_iff, descr]

end PatternStructure.Projection
