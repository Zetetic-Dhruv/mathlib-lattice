import MathlibLattice.Height.Filtration
import MathlibLattice.Order.PatternStructure.Sublanguage
import MathlibLattice.Query.Basic
import MathlibLattice.Term.PatternStructure

-- The library's files carry no copyright header.
set_option linter.style.header false

/-!
# The height filtration of a corpus of terms

The height of a first-order term is the depth of nesting of its function symbols: a variable has
height `0`, and `f(t₁, …, tₙ)` has height one more than the largest height of its arguments.
Substitution does not decrease heights, so an instance has at least the height of the term it
instantiates, variants have the same height, and the descriptions of the terms of height at most
`k` form a sublanguage `termHeightLe L α k` of the descriptions by terms, increasing with `k`. The
projections generated by these sublanguages form the height filtration `termFiltration L α`: at
level `k`, a description is sent to the join of its generalizations of height at most `k`, the
most general common instance of these generalizations.

Truncating terms at height `k` gives no projection. The fixed points of a projection are closed
under joins, while the descriptions of the terms of height at most `k ≥ 2` are not: in a language
with a binary symbol `f` and a unary symbol `g`, the most general common instance of
`f(x, g^(k-1)(x))` and `f(g(x), y)`, both of height at most `k`, is `f(g(x), g^k(x))`, of height
`k + 1`. For the same reason, the description of `f(g(x), g^k(x))` has no greatest generalization
of height at most `k`.

The height filtration is a chain of projections, so every statement about the levels of a
filtration applies to the levels of the height filtration of a corpus `τ : G → L.Term α`. The
extents at level `k` are the extents of the context of instantiation restricted to the terms of
height at most `k`. The filtration exhausts the corpus: a nonempty extent of the pattern structure
of `τ` is an extent at every level at least the height of the term of one of its objects, since it
is the extent of the least general generalization of the terms of its objects, whose height is at
most theirs. For a corpus of bounded height, in particular a finite corpus, the nonempty extents
of the levels at and above the largest height are exactly the nonempty extents of the corpus.

## Main definitions

* `MathlibLattice.Height.termHeight t`: the height of a term.
* `MathlibLattice.Height.termHeightLe L α k`: the descriptions of the terms of height at most `k`.
* `MathlibLattice.Height.termFiltration L α`: the height filtration of the descriptions by terms.
* `MathlibLattice.Height.termLevel τ k`: the pattern structure of a corpus at level `k`.

## Main statements

* `MathlibLattice.Height.termHeight_le_of_isInstance`: instantiation does not lower heights.
* `MathlibLattice.Height.termFiltration_le_succ`: the height filtration is a chain of projections.
* `MathlibLattice.Height.finite_termHeightLe`,
  `MathlibLattice.Height.finite_patternConcept_termLevel`: with finitely many function symbols,
  every level is finite.
* `MathlibLattice.Height.isExtent_termLevel_iff_order_isExtent`: the extents at level `k`.
* `MathlibLattice.Height.isExtent_termLevel`, `MathlibLattice.Height.isExtent_termLevel_iff`,
  `MathlibLattice.Height.exists_forall_isExtent_termLevel_iff`: the filtration exhausts the corpus.
* `MathlibLattice.Height.exists_sup_notMem_termHeightLe`,
  `MathlibLattice.Height.not_exists_projection_apply_eq_self_iff`,
  `MathlibLattice.Height.exists_not_isGreatest_termHeightLe`: truncation at a height is not a
  projection.

## References

* B. Ganter, S. O. Kuznetsov, *Pattern structures and their projections*, 2001.
* G. D. Plotkin, *A note on inductive generalization*, 1970.
* J. C. Reynolds, *Transformational systems and the algebraic structure of atomic formulas*,
  1970.
-/

namespace MathlibLattice.Height

open FirstOrder Language PatternStructure PatternConcept MathlibLattice.Term

universe u v w w' w''

variable {L : Language.{u, v}} {α : Type w} {β : Type w'} {G : Type w''}

/-! ### Heights of terms -/

/-- The height of a term: `0` for a variable, and one more than the largest height of its
arguments for `f(t₁, …, tₙ)`, so that a constant has height `1`. -/
def termHeight : L.Term α → ℕ
  | .var _ => 0
  | .func _ ts => (Finset.univ.sup fun i => termHeight (ts i)) + 1

/-- Substitution does not decrease heights: `termHeight t ≤ termHeight (t.subst σ)`. -/
theorem termHeight_le_termHeight_subst (t : L.Term α) (σ : α → L.Term β) :
    termHeight t ≤ termHeight (t.subst σ) := by
  induction t with
  | var => exact Nat.zero_le _
  | func f ts ih => exact Nat.succ_le_succ (Finset.sup_mono_fun fun i _ => ih i)

/-- An instance has at least the height of the term it instantiates. -/
theorem termHeight_le_of_isInstance {s : L.Term α} {t : L.Term β} (h : IsInstance s t) :
    termHeight t ≤ termHeight s :=
  h.elim fun σ hσ => hσ ▸ termHeight_le_termHeight_subst t σ

/-- Terms with the same description, that is, variants, have the same height. -/
theorem termHeight_eq_of_toTermDescr_eq {s t : L.Term α} (h : toTermDescr s = toTermDescr t) :
    termHeight s = termHeight t :=
  le_antisymm (termHeight_le_of_isInstance (toTermDescr_le_toTermDescr.1 h.le))
    (termHeight_le_of_isInstance (toTermDescr_le_toTermDescr.1 h.ge))

/-! ### The height filtration of the descriptions by terms -/

/-- The descriptions of the terms of height at most `k`. -/
def termHeightLe (L : Language.{u, v}) (α : Type w) (k : ℕ) : Set (TermDescr L α) :=
  {d | ∃ t : L.Term α, termHeight t ≤ k ∧ toTermDescr t = d}

/-- The description of a term has height at most `k` exactly when the term has. -/
theorem toTermDescr_mem_termHeightLe_iff {t : L.Term α} {k : ℕ} :
    toTermDescr t ∈ termHeightLe L α k ↔ termHeight t ≤ k :=
  ⟨fun ⟨_, hs, hst⟩ => termHeight_eq_of_toTermDescr_eq hst ▸ hs, fun ht => ⟨t, ht, rfl⟩⟩

/-- The descriptions of the terms of height at most `k` increase with `k`. -/
theorem monotone_termHeightLe : Monotone (termHeightLe L α) :=
  fun _ _ hk _ ⟨t, ht, hd⟩ => ⟨t, ht.trans hk, hd⟩

/-- Every description of a term has height at most some `k`: the sublanguages
`termHeightLe L α k` exhaust the descriptions of terms. -/
theorem iUnion_termHeightLe :
    ⋃ k, termHeightLe L α k = Set.range (toTermDescr : L.Term α → TermDescr L α) :=
  Set.ext fun _ => ⟨fun h => (Set.mem_iUnion.1 h).elim fun _ ⟨t, _, ht⟩ => ⟨t, ht⟩,
    fun ⟨t, ht⟩ => Set.mem_iUnion.2 ⟨_, t, le_rfl, ht⟩⟩

/-- Substituting variables for variables does not change the height of a term. -/
private lemma termHeight_subst_var (t : L.Term α) (f : α → β) :
    termHeight (t.subst fun x => Term.var (f x)) = termHeight t := by
  induction t with
  | var => rfl
  | func g ts ih => simp only [Term.subst, termHeight, ih]

/-- Over finitely many variables and function symbols, finitely many terms have height `≤ k`. -/
private lemma finite_setOf_termHeight_le [Finite β] [Finite (Σ n, L.Functions n)] (k : ℕ) :
    {t : L.Term β | termHeight t ≤ k}.Finite := by
  induction k with
  | zero =>
    refine (Set.finite_range Term.var).subset fun t ht => ?_
    cases t with
    | var x => exact ⟨x, rfl⟩
    | func f ts => exact absurd ht (by simp [termHeight])
  | succ k ih =>
    refine ((Set.finite_range Term.var).union (Set.finite_iUnion fun p : Σ n, L.Functions n =>
      (Set.Finite.pi fun _ => ih).image (Term.func p.2))).subset fun t ht => ?_
    cases t with
    | var x => exact Or.inl ⟨x, rfl⟩
    | func f ts => exact Or.inr (Set.mem_iUnion.2 ⟨⟨_, f⟩, ts, fun i _ =>
        (Finset.le_sup (f := fun i => termHeight (ts i)) (Finset.mem_univ i)).trans
          (Nat.le_of_succ_le_succ ht), rfl⟩)

/-- A term has finitely many generalizations up to renaming: `Iic (toTermDescr u)` is finite. -/
private lemma finite_Iic_toTermDescr (u : L.Term α) : (Set.Iic (toTermDescr u)).Finite := by
  refine ((finite_Ici (toAntisymmetrization (· ≤ ·) (toGenerality u))).image
    fun x => (OrderDual.toDual (WithBot.some x) : TermDescr L α)).subset fun d hd => ?_
  obtain rfl | ⟨v, rfl⟩ := eq_top_or_exists_toTermDescr_eq d
  · exact (toTermDescr_ne_top u (top_le_iff.1 hd)).elim
  · exact ⟨_, toAntisymmetrization_le_toAntisymmetrization_iff.2
      (toTermDescr_le_toTermDescr.1 hd), rfl⟩

-- `Finite (Σ n, L.Functions n)` is needed: the descriptions of infinitely many constants, or of
-- `f(x₁, …, xₙ)` for symbols `f` of infinitely many arities, are distinct and have height `1`.
/-- In a language with finitely many function symbols, there are finitely many descriptions of
terms of height at most `k`: finitely many terms up to renaming. -/
theorem finite_termHeightLe [Finite (Σ n, L.Functions n)] (k : ℕ) :
    (termHeightLe L α k).Finite := by
  rcases isEmpty_or_nonempty α with hα | hα
  · exact ((finite_setOf_termHeight_le k).image toTermDescr).subset
      fun _ ⟨t, ht, hd⟩ => ⟨t, ht, hd⟩
  · obtain ⟨x₀⟩ := hα
    refine (((finite_setOf_termHeight_le (β := Unit) k).image fun t' =>
      t'.subst fun _ => Term.var x₀).biUnion fun u _ => finite_Iic_toTermDescr u).subset ?_
    rintro _ ⟨t, ht, rfl⟩
    exact Set.mem_biUnion ⟨t.subst fun _ => Term.var (), (termHeight_subst_var t _).trans_le ht,
      rfl⟩ (toTermDescr_le_toTermDescr.2 ⟨_, (subst_subst t _ _).symm⟩)

/-- The height filtration of the descriptions by terms: at level `k`, a description is sent to
the join of the descriptions of height at most `k` below it. For the description of a term `t`,
this is the most general common instance of the generalizations of `t` of height at most `k`, of
which `t` is an instance. -/
noncomputable def termFiltration (L : Language.{u, v}) (α : Type w)
    [Fact (Finite α → Nat.card α = 1 ∨ Nat.card α = 2)] (k : ℕ) : Projection (TermDescr L α) :=
  Projection.ofSubset (termHeightLe L α k)

section Filtration

variable [Fact (Finite α → Nat.card α = 1 ∨ Nat.card α = 2)]

/-- The height filtration is a chain of projections, `termFiltration L α k d ≤
termFiltration L α (k + 1) d`: the hypothesis of the statements about the levels of a
filtration. -/
theorem termFiltration_le_succ (k : ℕ) (d : TermDescr L α) :
    termFiltration L α k d ≤ termFiltration L α (k + 1) d :=
  Projection.ofSubset_le_ofSubset_succ monotone_termHeightLe k d

/-- At every level at least the height of a term, the height filtration keeps its
description. -/
theorem termFiltration_toTermDescr {t : L.Term α} {k : ℕ} (hk : termHeight t ≤ k) :
    termFiltration L α k (toTermDescr t) = toTermDescr t :=
  Projection.ofSubset_apply_of_mem ⟨t, hk, rfl⟩

/-- The pattern structure at level `k` of the height filtration of a corpus `τ`: each object `g`
is described by the join of the generalizations of height at most `k` of its term `τ g`. -/
noncomputable abbrev termLevel (τ : G → L.Term α) (k : ℕ) : G → (termFiltration L α k).Fixed :=
  level (termFiltration L α) (termPattern τ) k

/-- Each level of the height filtration has finitely many fixed points: joins of subsets. -/
private local instance finite_fixed_termFiltration [Finite (Σ n, L.Functions n)] (k : ℕ) :
    Finite (termFiltration L α k).Fixed :=
  (((finite_termHeightLe k).powerset.image sSup).subset fun _ hd =>
    Projection.ofSubset_apply_eq_self_iff.1 hd).to_subtype

-- `Finite (Σ n, L.Functions n)` is needed: for the corpus of infinitely many constants, every
-- set of at most one object is an extent of level `1`.
/-- In a language with finitely many function symbols, every level of the height filtration of a
corpus has finitely many pattern concepts: their intents are joins of subsets of the finite set
`termHeightLe L α k`. The results on finite lattices therefore apply level by level. -/
instance finite_patternConcept_termLevel [Finite (Σ n, L.Functions n)] (τ : G → L.Term α)
    (k : ℕ) : Finite (PatternConcept (termLevel τ k)) :=
  Finite.of_injective _ PatternConcept.intent_injective

/-- Replacing the attributes along a surjection preserving the incidence keeps the extents. -/
private lemma order_isExtent_iff_of_surjective {β₁ β₂ : Type*} {r₁ : G → β₁ → Prop}
    {r₂ : G → β₂ → Prop} {f : β₂ → β₁} (hf : Function.Surjective f)
    (h : ∀ g b, r₂ g b ↔ r₁ g (f b)) {A : Set G} : Order.IsExtent r₁ A ↔ Order.IsExtent r₂ A := by
  refine ⟨fun ⟨T, hT⟩ => ⟨f ⁻¹' T, ?_⟩, fun ⟨T, hT⟩ => ⟨f '' T, ?_⟩⟩ <;> rw [← hT] <;> ext g
  · simp [mem_lowerPolar_iff, h, hf.forall]
  · simp [mem_lowerPolar_iff, h]

/-- The extents at level `k` of the height filtration of a corpus `τ` are the extents of the
context of instantiation restricted to the terms of height at most `k`: its objects are those of
`G`, its attributes the terms `t` with `termHeight t ≤ k`, and `g` has the attribute `t` when
`τ g` is an instance of `t`. -/
theorem isExtent_termLevel_iff_order_isExtent {τ : G → L.Term α} {k : ℕ} {A : Set G} :
    IsExtent (termLevel τ k) A ↔
      Order.IsExtent (fun g (t : {t : L.Term α // termHeight t ≤ k}) => IsInstance (τ g) t.1) A :=
  (Projection.isExtent_project_ofSubset_iff _ _).trans (order_isExtent_iff_of_surjective
    (f := fun t => ⟨toTermDescr t.1, t.1, t.2, rfl⟩)
    (fun ⟨_, t, ht, hd⟩ => ⟨⟨t, ht⟩, Subtype.ext hd⟩) fun _ _ => toTermDescr_le_termPattern.symm)

/-- The height filtration exhausts a corpus: a nonempty extent `A` of the pattern structure of
`τ` is an extent at every level `k` at least the height of the term of one of its objects. It is
the extent of the least general generalization of the terms of its objects, whose height is at
most theirs. -/
theorem isExtent_termLevel {τ : G → L.Term α} {A : Set G} (hA : IsExtent (termPattern τ) A)
    {g : G} (hg : g ∈ A) {k : ℕ} (hk : termHeight (τ g) ≤ k) : IsExtent (termLevel τ k) A := by
  obtain ⟨d, rfl⟩ := hA
  obtain rfl | ⟨t, rfl⟩ := eq_top_or_exists_toTermDescr_eq d
  · exact (toTermDescr_ne_top (τ g) (top_le_iff.1 hg)).elim
  · exact ((termFiltration L α k).isExtent_project_iff _).2 ⟨_, Projection.ofSubset_apply_of_mem
      ⟨t, (termHeight_le_of_isInstance (toTermDescr_le_termPattern.1 hg)).trans hk, rfl⟩, rfl⟩

-- `hA` is needed: in a language with a single unary symbol `g`, for the corpus whose one term is
-- `g(x)`, the empty set is an extent of the corpus, of the inconsistent description, but not of
-- level `1`, whose fixed points are the descriptions of `x` and `g(x)`. `hk` is needed: in the
-- same language, for the corpus of the two terms `g(g(x))` and `g(x)`, the extent `{0}` of the
-- corpus is not an extent of level `1`.
/-- For a corpus whose terms have height at most `k`, the nonempty extents at level `k` of the
height filtration are exactly the nonempty extents of the corpus. -/
theorem isExtent_termLevel_iff {τ : G → L.Term α} {k : ℕ} (hk : ∀ g, termHeight (τ g) ≤ k)
    {A : Set G} (hA : A.Nonempty) : IsExtent (termLevel τ k) A ↔ IsExtent (termPattern τ) A :=
  ⟨(termFiltration L α k).isExtent_of_isExtent_project _,
    fun h => hA.elim fun g hg => isExtent_termLevel h hg (hk g)⟩

-- `Finite G` is needed: in a language with a single unary symbol `g`, for the corpus of the
-- terms `g^n(x)`, `n : ℕ`, the extent `{n | k < n}` of the corpus is not an extent of level `k`.
/-- For a finite corpus, from some level on, the nonempty extents of the levels of the height
filtration are exactly the nonempty extents of the corpus. -/
theorem exists_forall_isExtent_termLevel_iff [Finite G] (τ : G → L.Term α) :
    ∃ k₀, ∀ k ≥ k₀, ∀ A : Set G, A.Nonempty →
      (IsExtent (termLevel τ k) A ↔ IsExtent (termPattern τ) A) := by
  obtain ⟨k₀, hk₀⟩ := Finite.exists_le fun g => termHeight (τ g)
  exact ⟨k₀, fun k hk A hA => isExtent_termLevel_iff (fun g => (hk₀ g).trans hk) hA⟩

/-! ### The statements about levels at the height filtration of a corpus -/

/-- Extents increase with the level of the height filtration of a corpus. -/
theorem isExtent_termLevel_of_le (τ : G → L.Term α) {k k' : ℕ} (hk : k ≤ k') :
    ∀ A, IsExtent (termLevel τ k) A → IsExtent (termLevel τ k') A :=
  isExtent_level_of_le (ψ := termFiltration L α) termFiltration_le_succ (termPattern τ) hk

/-- Closures decrease with the level of the height filtration of a corpus: the extent of the least
general generalization of a set of objects shrinks. -/
theorem antitone_extentOf_descr_termLevel (τ : G → L.Term α) (A : Set G) :
    Antitone fun k => extentOf (termLevel τ k) (descr (termLevel τ k) A) :=
  antitone_extentOf_descr_level (ψ := termFiltration L α) termFiltration_le_succ (termPattern τ) A

/-- The number of pattern concepts, in `ℕ∞`, increases with the level of the height filtration of
a corpus. -/
theorem monotone_enatCard_termLevel (τ : G → L.Term α) :
    Monotone fun k => ENat.card (PatternConcept (termLevel τ k)) :=
  monotone_enatCard_level (ψ := termFiltration L α) termFiltration_le_succ (termPattern τ)

/-- In a language with finitely many function symbols, the number of pattern concepts increases
with the level of the height filtration of a corpus. -/
theorem monotone_natCard_termLevel [Finite (Σ n, L.Functions n)] (τ : G → L.Term α) :
    Monotone fun k => Nat.card (PatternConcept (termLevel τ k)) :=
  monotone_natCard_level (ψ := termFiltration L α) termFiltration_le_succ (termPattern τ)

open Classical in
/-- Point counts, and so masses, push forward along the level maps of the height filtration of a
corpus: for `k ≤ k'`, the point count of a weighting `w` of the objects at a pattern concept `q`
of level `k` is the sum of its point counts at the pattern concepts of level `k'` whose closure
at level `k` is `q`. -/
theorem pt_ofObject_termLevel_eq_sum [Fintype G] {R : Type*} [AddCommMonoid R]
    (τ : G → L.Term α) {k k' : ℕ} (hk : k ≤ k') [Fintype (PatternConcept (termLevel τ k'))]
    (w : G → R) (q : PatternConcept (termLevel τ k)) :
    IncidenceAlgebra.pt (ofObject (termLevel τ k)) w q =
      ∑ p with toCoarse (termLevel τ k) p = q,
        IncidenceAlgebra.pt (ofObject (termLevel τ k')) w p :=
  pt_ofObject_level_eq_sum (ψ := termFiltration L α) termFiltration_le_succ hk w q

/-- Cumulative counts pull back along the level maps of the height filtration of a corpus: for
`k ≤ k'`, the cumulative count of a weighting `w` at a pattern concept `q` of level `k` is its
cumulative count at the pattern concept of level `k'` with the extent of `q`. -/
theorem cum_ofObject_termLevel_eq [Fintype G] {R : Type*} [AddCommMonoid R]
    (τ : G → L.Term α) {k k' : ℕ} (hk : k ≤ k') (w : G → R)
    (q : PatternConcept (termLevel τ k)) :
    IncidenceAlgebra.cum (ofObject (termLevel τ k)) w q =
      IncidenceAlgebra.cum (ofObject (termLevel τ k'))
        w (toFine (isExtent_termLevel_of_le τ hk) q) :=
  cum_ofObject_level_eq (ψ := termFiltration L α) termFiltration_le_succ hk w q

/-- The generalization query at the height filtration of a corpus: for `k ≤ k'`, the extent of
the concept generated by a set of objects `Q` in the formal context of level `k'` is contained in
its extent in the formal context of level `k`. -/
theorem extent_ofObjects_termLevel_subset (τ : G → L.Term α) {k k' : ℕ} (hk : k ≤ k')
    (Q : Set G) :
    (Concept.ofObjects (fun g d => d ≤ termLevel τ k' g) Q).extent ⊆
      (Concept.ofObjects (fun g d => d ≤ termLevel τ k g) Q).extent :=
  Query.extent_ofObjects_level_subset (ψ := termFiltration L α) termFiltration_le_succ
    (termPattern τ) hk Q

end Filtration

/-! ### Truncation at a height is not a projection -/

section Truncation

-- `Nontrivial α` is used by the witnesses: `f(g(x), y)` has two variables.
-- `2 ≤ k` is needed: in the language with only `f` and `g`, the joins of descriptions of height
-- at most `1` are the inconsistent description or have height at most `1`.
variable [Fact (Finite α → Nat.card α = 1 ∨ Nat.card α = 2)] [Nontrivial α]

omit [Fact (Finite α → Nat.card α = 1 ∨ Nat.card α = 2)] [Nontrivial α] in
/-- Applying a unary symbol `n` times raises the height of a term by `n`. -/
private lemma termHeight_iterate (g : L.Functions 1) (n : ℕ) (t : L.Term α) :
    termHeight ((fun s => Term.func g ![s])^[n] t) = termHeight t + n := by
  induction n with
  | zero => rfl
  | succ n ih =>
    rw [Function.iterate_succ_apply', ← add_assoc, ← ih]
    simp [termHeight]

omit [Fact (Finite α → Nat.card α = 1 ∨ Nat.card α = 2)] [Nontrivial α] in
/-- Substitution commutes with iterating a unary symbol. -/
private lemma subst_iterate (g : L.Functions 1) (n : ℕ) (t : L.Term α) (σ : α → L.Term β) :
    ((fun s => Term.func g ![s])^[n] t).subst σ = (fun s => Term.func g ![s])^[n] (t.subst σ) := by
  induction n with
  | zero => rfl
  | succ n ih =>
    rw [Function.iterate_succ_apply', Function.iterate_succ_apply', ← ih]
    simp [Term.subst, Matrix.vec_single_eq_const]

omit [Fact (Finite α → Nat.card α = 1 ∨ Nat.card α = 2)] [Nontrivial α] in
/-- A common instance of `f(x, g^(k-1)(x))` and `f(g(x), y)` has height more than `k`. -/
private lemma lt_termHeight_of_isInstance (f : L.Functions 2) (g : L.Functions 1) {k : ℕ}
    (hk : 1 ≤ k) {x y : α} {u : L.Term α} (hs : IsInstance u
      (Term.func f ![Term.var x, (fun s => Term.func g ![s])^[k - 1] (Term.var x)]))
    (ht : IsInstance u (Term.func f ![Term.func g ![Term.var x], Term.var y])) :
    k < termHeight u := by
  obtain ⟨σ, rfl⟩ := hs
  obtain ⟨ρ, hρ⟩ := ht
  simp only [Term.subst, Term.func.injEq, heq_eq_eq, funext_iff, Fin.forall_fin_two,
    Matrix.cons_val_zero, Matrix.cons_val_one, true_and] at hρ
  obtain ⟨h0, -⟩ := hρ
  simp [Term.subst, termHeight, Finset.univ_fin2, subst_iterate, termHeight_iterate, ← h0]
  lia

omit [Fact (Finite α → Nat.card α = 1 ∨ Nat.card α = 2)] in
/-- For `k ≥ 2`, two terms of height `≤ k` with a common instance, all of height `> k`. -/
private lemma exists_isInstance_lt_termHeight (f : L.Functions 2) (g : L.Functions 1) {k : ℕ}
    (hk : 2 ≤ k) :
    ∃ s t w : L.Term α, termHeight s ≤ k ∧ termHeight t ≤ k ∧ IsInstance w s ∧
      IsInstance w t ∧ ∀ u : L.Term α, IsInstance u s → IsInstance u t → k < termHeight u := by
  classical
  obtain ⟨x, y, hxy⟩ := exists_pair_ne α
  refine ⟨Term.func f ![Term.var x, (fun s => Term.func g ![s])^[k - 1] (Term.var x)],
    Term.func f ![Term.func g ![Term.var x], Term.var y],
    Term.func f ![Term.func g ![Term.var x],
      (fun s => Term.func g ![s])^[k - 1] (Term.func g ![Term.var x])],
    ?_, ?_, ⟨fun _ => Term.func g ![Term.var x], ?_⟩, ⟨Function.update Term.var y
      ((fun s => Term.func g ![s])^[k - 1] (Term.func g ![Term.var x])), ?_⟩,
    fun u => lt_termHeight_of_isInstance f g (by lia)⟩
  · simp [termHeight, Finset.univ_fin2, termHeight_iterate]
    lia
  · simp [termHeight, Finset.univ_fin2]
    lia
  · simp [Term.subst, subst_iterate, funext_iff, Fin.forall_fin_two]
  · simp [Term.subst, hxy, funext_iff, Fin.forall_fin_two]

/-- The descriptions of the terms of height at most `k ≥ 2` are not closed under joins, in every
language with a binary function symbol `f` and a unary function symbol `g`: the descriptions of
`f(x, g^(k-1)(x))` and `f(g(x), y)` have as join the description of their most general common
instance `f(g(x), g^k(x))`, of height `k + 1`. -/
theorem exists_sup_notMem_termHeightLe (f : L.Functions 2) (g : L.Functions 1) {k : ℕ}
    (hk : 2 ≤ k) :
    ∃ s t : L.Term α, termHeight s ≤ k ∧ termHeight t ≤ k ∧
      toTermDescr s ⊔ toTermDescr t ≠ ⊤ ∧ toTermDescr s ⊔ toTermDescr t ∉ termHeightLe L α k := by
  obtain ⟨s, t, w, hs, ht, hws, hwt, hu⟩ := exists_isInstance_lt_termHeight (α := α) f g hk
  refine ⟨s, t, hs, ht, fun h => toTermDescr_ne_top w (top_le_iff.1 (h.symm.trans_le
    (sup_le (toTermDescr_le_toTermDescr.2 hws) (toTermDescr_le_toTermDescr.2 hwt)))), ?_⟩
  rintro ⟨u, hu', hd⟩
  exact (hu u (toTermDescr_le_toTermDescr.1 (le_sup_left.trans_eq hd.symm))
    (toTermDescr_le_toTermDescr.1 (le_sup_right.trans_eq hd.symm))).not_ge hu'

/-- Truncation at a height is not a projection: for `k ≥ 2`, in every language with a binary and
a unary function symbol, no projection of the descriptions by terms has as fixed points, apart
from the inconsistent description, exactly the descriptions of the terms of height at most `k`,
since the fixed points of a projection are closed under joins
(`PatternStructure.Projection.apply_sSup_eq_sSup`). -/
theorem not_exists_projection_apply_eq_self_iff (f : L.Functions 2) (g : L.Functions 1) {k : ℕ}
    (hk : 2 ≤ k) :
    ¬∃ ψ : Projection (TermDescr L α), ∀ d, d ≠ ⊤ → (ψ d = d ↔ d ∈ termHeightLe L α k) := by
  rintro ⟨ψ, hψ⟩
  obtain ⟨s, t, hs, ht, hne, hnot⟩ := exists_sup_notMem_termHeightLe (α := α) f g hk
  refine hnot ((hψ _ hne).1 ?_)
  rw [← sSup_pair]
  refine ψ.apply_sSup_eq_sSup ?_
  rintro _ (rfl | rfl)
  · exact (hψ _ (toTermDescr_ne_top s)).2 ⟨s, hs, rfl⟩
  · exact (hψ _ (toTermDescr_ne_top t)).2 ⟨t, ht, rfl⟩

/-- A description need not have a greatest generalization of height at most `k`: for `k ≥ 2`, in
every language with a binary symbol `f` and a unary symbol `g`, the generalizations
`f(x, g^(k-1)(x))` and `f(g(x), y)` of `f(g(x), g^k(x))` have height at most `k`, and their join is
the description of `f(g(x), g^k(x))` itself, of height `k + 1`. -/
theorem exists_not_isGreatest_termHeightLe (f : L.Functions 2) (g : L.Functions 1) {k : ℕ}
    (hk : 2 ≤ k) :
    ∃ t : L.Term α, ¬∃ m, IsGreatest {e | e ∈ termHeightLe L α k ∧ e ≤ toTermDescr t} m := by
  obtain ⟨s, t, hs, ht, hne, hnot⟩ := exists_sup_notMem_termHeightLe (α := α) f g hk
  obtain ⟨w, hw⟩ := (eq_top_or_exists_toTermDescr_eq _).resolve_left hne
  exact ⟨w, fun ⟨m, ⟨hm, hmw⟩, hub⟩ => hnot (le_antisymm (hmw.trans_eq hw) (sup_le
    (hub ⟨⟨s, hs, rfl⟩, le_sup_left.trans_eq hw.symm⟩)
    (hub ⟨⟨t, ht, rfl⟩, le_sup_right.trans_eq hw.symm⟩)) ▸ hm)⟩

end Truncation

end MathlibLattice.Height
