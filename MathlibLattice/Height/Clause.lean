import MathlibLattice.Height.Filtration
import MathlibLattice.Term.PatternStructure

-- The library's files carry no copyright header.
set_option linter.style.header false

/-!
# Concepts, masses and levels of a corpus of clauses

A corpus of clauses `τ : G → Clause L α`, such as the conditional statements of a library, ordered
by θ-subsumption, has the pattern structure `MathlibLattice.Term.clausePattern τ`. When the corpus
is finite and `α` is infinite or empty, the descriptions of the clauses of every nonempty set of
statements have a meet, the description of their least general generalization (Plotkin 1970),
although the descriptions by clauses form no complete lattice
(`MathlibLattice.Term.ClauseDescr.instIsGLBDescr`).
The statements about the masses and the coverage of pattern concepts, about coarsenings of the
descriptions, and about the levels of a chain of projections therefore apply to finite corpora of
clauses.

The extents of the pattern structure of a finite corpus are the empty set, the extent of the
inconsistent description, and the extents of the subsumption context, which relates each
statement to the clauses subsuming it: a nonempty extent of this context is the set of statements
whose clauses are subsumed by the least general generalization of its clauses. When no statement
is subsumed by every clause, the empty set is an extent of the subsumption context too, and the
pattern concepts are its formal concepts, by a map preserving extents.

No clause has the inconsistent description, so no statement lies in the extent of the least
pattern concept. Hence the coverage of a nonempty finite corpus of clauses, and more generally
the total weight of the extents for any nonnegative weighting of the statements of total weight
`1`, is a belief function on its lattice of pattern concepts. A pattern concept has positive mass
exactly when its intent, the description of the least general generalization of the clauses of
its extent, is the description of a clause of the corpus.

The levels of every chain of projections of the descriptions by clauses are pattern structures as
well (`PatternStructure.Projection.isGLBDescr_project`), so their extents increase, their closures
and join gaps decrease, and their numbers of pattern concepts increase with the level. A height
filtration of clauses would be such a chain. The projections generated by sublanguages
(`PatternStructure.Projection.ofSubset`), which give the height filtration of terms, take joins of
arbitrary sets of descriptions in a complete lattice, and the descriptions by clauses do not form
one, since an infinite set of clauses need not have a least general generalization. A height
filtration of a corpus of clauses therefore needs another construction.

## Main definitions

* `MathlibLattice.Height.clausePatternOrderIso`: the pattern concepts of a finite corpus of clauses
  are the formal concepts of its subsumption context when no statement is subsumed by every
  clause.

## Main statements

* `MathlibLattice.Height.isExtent_clausePattern_iff`: the extents of the pattern structure.
* `MathlibLattice.Height.isBeliefFunction_coverage_clausePattern`,
  `MathlibLattice.Height.isBeliefFunction_cum_ofObject_clausePattern`: the coverage, and the total
  weight of the extents for a nonnegative weighting, are belief functions.
* `MathlibLattice.Height.mass_clausePattern_pos_iff`: the pattern concepts of positive mass.
* `MathlibLattice.Height.monotone_natCard_level_clausePattern`: the numbers of pattern concepts of
  the levels of a chain of projections increase.

## References

* G. D. Plotkin, *A note on inductive generalization*, 1970.
* B. Ganter, S. O. Kuznetsov, *Pattern structures and their projections*, 2001.
* M. Grabisch, *Belief functions on lattices*, Int. J. Intell. Syst. 24 (2009).
-/

namespace MathlibLattice.Height

open FirstOrder Language IncidenceAlgebra PatternStructure PatternConcept MathlibLattice.Term

universe u v w w'

-- The hypothesis on `α` makes a finite corpus of clauses a pattern structure: over finitely many
-- variables, at least one, two clauses can lack a least general generalization
-- (`Subsumption.exists_isLUB_pair`), and then their descriptions have no meet.
variable {L : Language.{u, v}} {α : Type w} {G : Type w'} [Fact (Finite α → IsEmpty α)]

/-! ### The subsumption context -/

omit [Fact (Finite α → IsEmpty α)] in
/-- The extent of the inconsistent description is empty: no clause has it. -/
private lemma extentOf_clausePattern_top (τ : G → Clause L α) :
    extentOf (clausePattern τ) ⊤ = ∅ :=
  Set.eq_empty_iff_forall_notMem.2 fun g hg => toClauseDescr_ne_top (τ g) (top_le_iff.1 hg)

-- `Finite G` is needed: for the corpus of the ground directed cycles `P(c₀, c₁), …, P(cₚ₋₁, c₀)`
-- of all prime lengths `p` and of the ground directed paths of all lengths, on disjoint sets of
-- constants, the cycles are the statements subsumed by every directed path
-- `P(x₀, x₁), …, P(xₖ₋₁, xₖ)`, while a clause subsuming every cycle subsumes every long enough
-- ground path. The hypothesis on `α` is needed: over finitely many variables, at least one, the
-- two clauses of `Subsumption.exists_isLUB_pair` and their minimal upper bounds form a corpus in
-- which the statements of the two clauses are an extent of the subsumption context only.
/-- The extents of the pattern structure of a finite corpus of clauses are the empty set, the
extent of the inconsistent description, and the extents of the subsumption context, which relates
each statement to the clauses subsuming it: a nonempty extent of this context is the set of
statements whose clauses are subsumed by the least general generalization of its clauses. -/
theorem isExtent_clausePattern_iff [Finite G] {τ : G → Clause L α} {A : Set G} :
    IsExtent (clausePattern τ) A ↔
      A = ∅ ∨ Order.IsExtent (fun g (C : Clause L α) => Subsumes C (τ g)) A := by
  refine ⟨?_, ?_⟩
  · rintro ⟨d, rfl⟩
    obtain rfl | ⟨C, rfl⟩ := eq_top_or_exists_toDescr_eq d
    · exact Or.inl (extentOf_clausePattern_top τ)
    · exact Or.inr ⟨{ofSubsumption C}, Set.ext fun _ =>
        (mem_lowerPolar_singleton _).trans toClauseDescr_le_clausePattern.symm⟩
  · rintro (rfl | hA)
    · exact ⟨⊤, extentOf_clausePattern_top τ⟩
    · exact isExtent_of_order_isExtent (fun _ _ => toClauseDescr_le_clausePattern.symm) hA

-- `h` is needed: the empty set is an extent of the pattern structure, and it is an extent of the
-- subsumption context exactly when no statement is subsumed by every clause
-- (`MathlibLattice.Term.order_isExtent_empty_le_iff`).
/-- If no statement of a finite corpus of clauses is subsumed by every clause, the extents of its
pattern structure are exactly the extents of its subsumption context. -/
theorem isExtent_clausePattern_iff_order_isExtent [Finite G] {τ : G → Clause L α}
    (h : ∀ g, ∃ C : Clause L α, ¬Subsumes C (τ g)) {A : Set G} :
    IsExtent (clausePattern τ) A ↔ Order.IsExtent (fun g (C : Clause L α) => Subsumes C (τ g)) A :=
  isExtent_clausePattern_iff.trans
    (or_iff_right_of_imp fun hA => hA ▸
      (order_isExtent_empty_le_iff (τ := fun g => toSubsumption (τ g))).2 h)

-- `h` is needed, by the comment before `isExtent_clausePattern_iff_order_isExtent`: a map
-- preserving extents sends the pattern concept with extent `∅` to a concept with extent `∅`.
/-- If no statement of a finite corpus of clauses is subsumed by every clause, the pattern concepts
of the corpus are the formal concepts of its subsumption context
`(G, Clause L α, fun g C => Subsumes C (τ g))`, by a map preserving extents (Ganter–Kuznetsov
2001, Plotkin 1970). -/
noncomputable def clausePatternOrderIso [Finite G] (τ : G → Clause L α)
    (h : ∀ g, ∃ C : Clause L α, ¬Subsumes C (τ g)) :
    PatternConcept (clausePattern τ) ≃o Concept G (Clause L α) fun g C => Subsumes C (τ g) where
  toFun c := Concept.ofIsExtent _ c.extent
    ((isExtent_clausePattern_iff_order_isExtent h).1 c.isExtent_extent)
  invFun c := PatternConcept.ofIsExtent _ c.extent
    ((isExtent_clausePattern_iff_order_isExtent h).2 c.isExtent_extent)
  left_inv _ := PatternConcept.ext rfl
  right_inv _ := Concept.ext rfl
  map_rel_iff' := Iff.rfl

/-- The isomorphism `clausePatternOrderIso` preserves extents. -/
@[simp]
theorem clausePatternOrderIso_apply_extent [Finite G] (τ : G → Clause L α)
    (h : ∀ g, ∃ C : Clause L α, ¬Subsumes C (τ g)) (c : PatternConcept (clausePattern τ)) :
    (clausePatternOrderIso τ h c).extent = c.extent :=
  rfl

/-- The inverse of the isomorphism `clausePatternOrderIso` preserves extents. -/
@[simp]
theorem clausePatternOrderIso_symm_apply_extent [Finite G] (τ : G → Clause L α)
    (h : ∀ g, ∃ C : Clause L α, ¬Subsumes C (τ g))
    (c : Concept G (Clause L α) fun g C => Subsumes C (τ g)) :
    ((clausePatternOrderIso τ h).symm c).extent = c.extent :=
  rfl

/-! ### Masses and coverage -/

-- `Finite G` and `Nonempty G` are needed, as for `PatternConcept.isBeliefFunction_coverage_iff`:
-- otherwise `Nat.card G = 0` and the coverage of `⊤` is `0`.
/-- The coverage of a nonempty finite corpus of clauses is a belief function on its lattice of
pattern concepts (Grabisch 2009): no clause has the inconsistent description, so no statement lies
in the extent of the least pattern concept. -/
theorem isBeliefFunction_coverage_clausePattern [Finite G] [Nonempty G] (τ : G → Clause L α)
    [LocallyFiniteOrder (PatternConcept (clausePattern τ))]
    [DecidableEq (PatternConcept (clausePattern τ))] :
    IsBeliefFunction (PatternConcept.coverage (clausePattern τ)) :=
  PatternConcept.isBeliefFunction_coverage_iff.2 fun g hg => toClauseDescr_ne_top (τ g) hg.eq_top

-- `AddLeftMono R` is needed, as for `IncidenceAlgebra.isImplicabilityFunction_cum`.
/-- For a nonnegative weighting `w` of total weight `1` of the statements of a finite corpus of
clauses, by use, importance or a prior, the total weight of the extents, the cumulative count of
`w` along the object concepts, is a belief function on the lattice of pattern concepts. -/
theorem isBeliefFunction_cum_ofObject_clausePattern [Fintype G] (τ : G → Clause L α)
    [LocallyFiniteOrder (PatternConcept (clausePattern τ))]
    [DecidableEq (PatternConcept (clausePattern τ))] {R : Type*} [AddCommGroup R] [Preorder R]
    [AddLeftMono R] [One R] {w : G → R} (hw : ∀ g, 0 ≤ w g) (hw1 : ∑ g, w g = 1) :
    IsBeliefFunction (cum (ofObject (clausePattern τ)) w) :=
  isBeliefFunction_cum hw hw1 fun ⟨g, hg⟩ =>
    toClauseDescr_ne_top (τ g) (PatternConcept.ofObject_eq_bot_iff.1 hg).eq_top

-- `Finite G` is needed, as for `PatternConcept.mass_pos_iff`: for infinitely many statements
-- every mass is `0`.
/-- A pattern concept of a finite corpus of clauses has positive mass if and only if its intent,
the description of the least general generalization of the clauses of its extent, is the
description of a clause of the corpus. The pattern concepts of mass `0` are those whose intent is
inconsistent or the description of a least general generalization that is equivalent under
θ-subsumption to no clause of the corpus. -/
theorem mass_clausePattern_pos_iff [Finite G] {τ : G → Clause L α}
    {c : PatternConcept (clausePattern τ)} :
    0 < PatternConcept.mass (clausePattern τ) c ↔ ∃ g, c.intent = clausePattern τ g :=
  PatternConcept.mass_pos_iff.trans (exists_congr fun g => ⟨fun h => h ▸ intent_ofObject _ g,
    fun h => intent_injective ((intent_ofObject _ g).trans h.symm)⟩)

/-! ### Levels -/

/-- A pattern structure on finitely many objects has finitely many pattern concepts. -/
private local instance instFinitePatternConcept {D : Type*} [LE D] [InfSet D] [Finite G]
    (δ : G → D) : Finite (PatternConcept δ) :=
  Finite.of_injective _ PatternConcept.extent_injective

-- `Finite G` is needed, as for `monotone_natCard_level`: an infinite corpus can have finitely many
-- pattern concepts at one level and infinitely many at the next.
/-- For a finite corpus of clauses and every chain of projections `ψ` of the descriptions by
clauses, the number of pattern concepts of level `k` increases with `k`: the levels are pattern
structures, each with finitely many pattern concepts, so this is `monotone_natCard_level`. -/
theorem monotone_natCard_level_clausePattern [Finite G] (τ : G → Clause L α)
    {ψ : ℕ → Projection (ClauseDescr L α)} (hψ : ∀ k d, ψ k d ≤ ψ (k + 1) d) :
    Monotone fun k => Nat.card (PatternConcept (level ψ (clausePattern τ) k)) :=
  monotone_natCard_level hψ (clausePattern τ)

end MathlibLattice.Height
